-- ============================
-- DETEKSI BAHASA OTOMATIS
-- ============================
local function getPlayerLanguage()
    -- Coba ambil dari locale Roblox
    local success, locale = pcall(function()
        return UserInputService:GetPlatform() and player.LocaleId
    end)
    
    if success and locale then
        local code = string.upper(string.sub(locale, 1, 2))
        if Translations[code] then
            return code
        end
    end
    
    -- Fallback: coba cek bahasa dari game
    return "ID" -- default Indonesia
end

