local Window = {}
Window.__index = Window

function Library:CreateWindow(config)
    config = config or {}
    local themeName = config.Theme or self.CurrentThemeName or "BlueGold"
    local theme = self.Themes[themeName]
    self.CurrentTheme = theme
    self.CurrentThemeName = themeName

    local deviceClass = Device.GetClass()
    local mobileLayout = (config.MobileLayout ~= nil) and config.MobileLayout or (deviceClass ~= "Desktop")
    local viewport = Device.GetViewport()

    -- Adaptive default size: percentage of the screen on touch devices
    -- (near-fullscreen on phones, comfortably large on tablets), a fixed
    -- pixel size on desktop like before (unless the user overrides it).
    local size
    if config.Size then
        size = config.Size
    elseif deviceClass == "Mobile" then
        size = UDim2.fromScale(0.94, 0.86)
    elseif deviceClass == "Tablet" then
        size = UDim2.fromScale(0.82, 0.8)
    else
        size = UDim2.fromOffset(640, 480)
    end

    local screenGui = Create("ScreenGui", {
        Name = "CyrusLib", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = mobileLayout,
        Parent = ParentGui,
    })

    -- ambient glow behind the window for a more modern "floating glass" look
    local glow = Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084", -- soft round glow
        ImageColor3 = theme.Accent,
        ImageTransparency = 0.72,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(100, 100, 100, 100),
        Size = UDim2.new(1, 120, 1, 120),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = -1,
        Parent = screenGui,
    })

    local shadow = Create("Frame", {
        BackgroundColor3 = Color3.new(0,0,0),
        BackgroundTransparency = 0.5,
        Size = size,
        Position = UDim2.new(0.5, 4, 0.5, 6),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = 0,
        Parent = screenGui,
    })
    Utility.Corner(shadow, 18)

    local main = Create("Frame", {
        BackgroundColor3 = theme.Background,
        Size = UDim2.fromOffset(0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = true,
        Parent = screenGui,
    })
    Utility.Corner(main, mobileLayout and 20 or 14)
    local mainStroke = Utility.Stroke(main, theme.Gold, 1.5, 0.25)
    Themed(main, function(t)
        main.BackgroundColor3 = t.Background
        mainStroke.Color = t.Gold
    end)
    -- subtle top-to-bottom gradient for depth (glass feel)
    Utility.Gradient(main, ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200,200,200)),
    }, 90, NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0.94),
        NumberSequenceKeypoint.new(1, 0.98),
    })

    -- live UIScale: recomputed whenever the viewport size changes so the
    -- whole window (fonts included, via TextScaled where used) rescales
    -- instead of clipping or looking tiny/huge after a resize.
    local uiScale = Create("UIScale", {Scale = 1, Parent = main})
    Create("UIScale", {Scale = 1, Parent = shadow})

    local topbarH = mobileLayout and 58 or 54
    local topbar = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, topbarH),
        Parent = main,
    })
    Utility.Corner(topbar, mobileLayout and 20 or 14)
    Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 1, -14),
        Parent = topbar,
    })
    Themed(topbar, function(t) topbar.BackgroundColor3 = t.Secondary end)
    -- thin gold->blue gradient line under the topbar for a modern accent
    local topbarLine = Create("Frame", {
        BackgroundColor3 = theme.Gold,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -1),
        Parent = topbar,
    })
    local topbarLineGrad = Utility.Gradient(topbarLine, ColorSequence.new(theme.Gold, theme.Accent))
    Themed(topbarLine, function(t) topbarLineGrad.Color = ColorSequence.new(t.Gold, t.Accent) end)

    local titleLabel = Create("TextLabel", {
        Text = config.Title or "CyrusLib",
        Font = Enum.Font.GothamBlack, TextSize = mobileLayout and 19 or 18, TextColor3 = theme.Gold,
        BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 20, 0, mobileLayout and 10 or 8), Size = UDim2.new(1, -170, 0, 22),
        Parent = topbar,
    })
    Themed(titleLabel, function(t) titleLabel.TextColor3 = t.Gold end)
    local subtitleLabel = Create("TextLabel", {
        Text = config.Subtitle or "v" .. Library.Version,
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = theme.SubText,
        BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 20, 0, mobileLayout and 32 or 30), Size = UDim2.new(1, -170, 0, 16),
        Parent = topbar,
    })

    local btnSize = mobileLayout and 34 or 28
    local closeBtn = Create("TextButton", {
        Text = "✕", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = theme.SubText,
        BackgroundColor3 = theme.Elevated, Size = UDim2.fromOffset(btnSize, btnSize),
        Position = UDim2.new(1, -18, 0, mobileLayout and 12 or 13), AnchorPoint = Vector2.new(1, 0),
        AutoButtonColor = false, Parent = topbar,
    })
    Utility.Corner(closeBtn, 7)
    Themed(closeBtn, function(t) closeBtn.BackgroundColor3 = t.Elevated end)
    Utility.PressFeedback(closeBtn, 0.08)
    if not mobileLayout then
        closeBtn.MouseEnter:Connect(function()
            Utility.Tween(closeBtn, 0.15, {BackgroundColor3 = theme.Error, TextColor3 = Color3.new(1,1,1)})
        end)
        closeBtn.MouseLeave:Connect(function()
            Utility.Tween(closeBtn, 0.15, {BackgroundColor3 = theme.Elevated, TextColor3 = theme.SubText})
        end)
    end

    local minBtn = Create("TextButton", {
        Text = "—", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = theme.SubText,
        BackgroundColor3 = theme.Elevated, Size = UDim2.fromOffset(btnSize, btnSize),
        Position = UDim2.new(1, -18 - btnSize - 8, 0, mobileLayout and 12 or 13), AnchorPoint = Vector2.new(1, 0),
        AutoButtonColor = false, Parent = topbar,
    })
    Utility.Corner(minBtn, 7)
    Themed(minBtn, function(t) minBtn.BackgroundColor3 = t.Elevated end)
    Utility.PressFeedback(minBtn, 0.08)
    if not mobileLayout then
        minBtn.MouseEnter:Connect(function()
            Utility.Tween(minBtn, 0.15, {BackgroundColor3 = theme.Accent, TextColor3 = Color3.new(1,1,1)})
        end)
        minBtn.MouseLeave:Connect(function()
            Utility.Tween(minBtn, 0.15, {BackgroundColor3 = theme.Elevated, TextColor3 = theme.SubText})
        end)
    end

    Utility.MakeDraggable(main, topbar)

    -- SIDEBAR (desktop/tablet) or BOTTOM BAR (mobile)
    local sidebar, tabList, pageHolder

    if mobileLayout then
        local bottomH = 64
        sidebar = Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            Size = UDim2.new(1, 0, 0, bottomH),
            Position = UDim2.new(0, 0, 1, 0),
            AnchorPoint = Vector2.new(0, 1),
            Parent = main,
        })
        Utility.Corner(sidebar, 20)
        Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            Size = UDim2.new(1, 0, 0, 20),
            Parent = sidebar,
        })
        Themed(sidebar, function(t) sidebar.BackgroundColor3 = t.Secondary end)

        tabList = Create("ScrollingFrame", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.new(0, 8, 0, 0),
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.X,
            ScrollingDirection = Enum.ScrollingDirection.X,
            ScrollBarThickness = 0,
            Parent = sidebar,
        })
        Utility.ListLayout(tabList, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

        pageHolder = Create("Frame", {
            BackgroundColor3 = theme.Elevated,
            Size = UDim2.new(1, -20, 1, -topbarH - bottomH - 20),
            Position = UDim2.new(0, 10, 0, topbarH + 10),
            Parent = main,
        })
        Utility.Corner(pageHolder, 14)
        local phStroke = Utility.Stroke(pageHolder, theme.Border, 1, 0.7)
        Themed(pageHolder, function(t)
            pageHolder.BackgroundColor3 = t.Elevated
            phStroke.Color = t.Border
        end)
    else
        sidebar = Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 160, 1, -66),
            Position = UDim2.new(0, 0, 0, 54),
            Parent = main,
        })
        Utility.Padding(sidebar, 8, 8, 8, 8)

        tabList = Create("ScrollingFrame", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.Gold,
            Parent = sidebar,
        })
        Utility.ListLayout(tabList, Enum.FillDirection.Vertical, 4)

        pageHolder = Create("Frame", {
            BackgroundColor3 = theme.Elevated,
            Size = UDim2.new(1, -180, 1, -78),
            Position = UDim2.new(0, 172, 0, 66),
            Parent = main,
        })
        Utility.Corner(pageHolder, 10)
        local phStroke = Utility.Stroke(pageHolder, theme.Border, 1, 0.7)
        Themed(pageHolder, function(t)
            pageHolder.BackgroundColor3 = t.Elevated
            phStroke.Color = t.Border
        end)
    end

    -- FLOATING BUTTON (minimized)
    local floatSize = mobileLayout and 58 or 50
    local floatBtn = Create("ImageButton", {
        BackgroundColor3 = theme.Gold, Visible = false,
        Size = UDim2.fromOffset(floatSize, floatSize),
        Position = UDim2.new(0.5, -floatSize/2, mobileLayout and 0.88 or 0.85, 0),
        AutoButtonColor = false, Parent = screenGui,
    })
    Utility.Corner(floatBtn, 999)
    Utility.Stroke(floatBtn, theme.Accent, 2)
    Create("TextLabel", {
        Text = "☰", Font = Enum.Font.GothamBold, TextSize = mobileLayout and 22 or 20,
        TextColor3 = Color3.fromRGB(15,15,20), BackgroundTransparency = 1,
        Size = UDim2.new(1,0,1,0), Parent = floatBtn,
    })
    Utility.MakeDraggable(floatBtn)
    Utility.PressFeedback(floatBtn, 0.08)

    -- resize handle: hidden on mobile (window is fullscreen-ish, resizing
    -- by dragging a tiny corner doesn't make sense on a phone).
    local resizeHandle, resizeGrip
    if not mobileLayout then
        resizeHandle = Create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromOffset(16, 16),
            Position = UDim2.new(1, -6, 1, -6),
            AnchorPoint = Vector2.new(1, 1),
            Parent = main,
        })
        resizeGrip = Create("Frame", {
            BackgroundColor3 = theme.Gold,
            BackgroundTransparency = 0.3,
            Size = UDim2.fromOffset(10, 10),
            Position = UDim2.new(1, -6, 1, -6),
            AnchorPoint = Vector2.new(1, 1),
            Parent = main,
        })
        Utility.Corner(resizeGrip, 3)
    end

    local self = setmetatable({
        ScreenGui = screenGui, Main = main, Shadow = shadow, Glow = glow,
        TabList = tabList, PageHolder = pageHolder, Sidebar = sidebar,
        Tabs = {}, FirstTab = nil, Minimized = false,
        TargetSize = size, FloatBtn = floatBtn, Topbar = topbar,
        TitleLabel = titleLabel, SubtitleLabel = subtitleLabel,
        MobileLayout = mobileLayout, UIScale = uiScale,
    }, Window)

    if resizeHandle then
        local resizing, resizeStart, startSize
        resizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                resizeStart = input.Position
                startSize = main.AbsoluteSize
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - resizeStart
                local newW = math.max(480, startSize.X + delta.X)
                local newH = math.max(320, startSize.Y + delta.Y)
                main.Size = UDim2.fromOffset(newW, newH)
                shadow.Size = UDim2.fromOffset(newW, newH)
                self.TargetSize = UDim2.fromOffset(newW, newH)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
    end

    -- keep the window sized correctly if the viewport changes (phone
    -- rotation, PC window resize, changing resolution) by re-deriving a
    -- gentle UIScale factor rather than fighting the layout engine.
    local baseViewport = Device.GetViewport()
    local function onViewportChanged()
        local vp = Device.GetViewport()
        if mobileLayout then
            -- scale-based sizes already adapt automatically; just nudge
            -- font/UI scale slightly for very small/large phones.
            local scale = math.clamp(vp.X / baseViewport.X, 0.85, 1.15)
            Utility.Tween(uiScale, 0.25, {Scale = scale})
        else
            local scale = math.clamp(math.min(vp.X / 1440, vp.Y / 900), 0.75, 1.15)
            Utility.Tween(uiScale, 0.25, {Scale = scale})
        end
    end
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged)

    -- open animation
    Utility.Tween(main, 0.4, {Size = size}, Enum.EasingStyle.Back)
    Utility.Tween(shadow, 0.4, {Size = size}, Enum.EasingStyle.Back)

    closeBtn.MouseButton1Click:Connect(function() self:Toggle() end)
    minBtn.MouseButton1Click:Connect(function() self:Minimize() end)
    floatBtn.MouseButton1Click:Connect(function() self:Minimize() end)

    Library.ActiveWindow = self
    Library.Windows = Library.Windows or {}
    table.insert(Library.Windows, self)
    return self
end

function Window:CreateTab(config)
    local tab = NewTab(self, config)
    if not self.Selected then self:SelectTab(config.Title) end
    return tab
end

function Window:SelectTab(title)
    local tab = self.Tabs[title]
    if not tab then return end
    for t, other in pairs(self.Tabs) do
        other.Instance.Visible = (t == title)
        other.Paint(t == title)
    end
    self.Selected = title
end

function Window:SetTitle(text)
    self.TitleLabel.Text = text
end
Window.Rename = Window.SetTitle

function Window:Toggle()
    local visible = self.Main.Visible
    if visible then
        Utility.Tween(self.Main, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Utility.Tween(self.Shadow, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function()
            self.Main.Visible = false
            self.Shadow.Visible = false
        end)
    else
        self.Main.Visible = true
        self.Shadow.Visible = true
        self.Main.Size = UDim2.fromOffset(0,0)
        Utility.Tween(self.Main, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
        Utility.Tween(self.Shadow, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
    end
end

function Window:Minimize()
    self.Minimized = not self.Minimized
    if self.Minimized then
        Utility.Tween(self.Main, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Utility.Tween(self.Shadow, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function()
            self.Main.Visible = false
            self.Shadow.Visible = false
            self.FloatBtn.Visible = true
            self.FloatBtn.Size = UDim2.fromOffset(0,0)
            Utility.Tween(self.FloatBtn, 0.25, {Size = UDim2.fromOffset(50,50)}, Enum.EasingStyle.Back)
        end)
    else
        Utility.Tween(self.FloatBtn, 0.2, {Size = UDim2.fromOffset(0,0)})
        task.delay(0.2, function()
            self.FloatBtn.Visible = false
            self.Main.Visible = true
            self.Shadow.Visible = true
            self.Main.Size = UDim2.fromOffset(0,0)
            Utility.Tween(self.Main, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
            Utility.Tween(self.Shadow, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
        end)
    end
end

function Window:Destroy()
    self.ScreenGui:Destroy()
end

----------------------------------------------------------------------
-- LIBRARY EXTRAS
----------------------------------------------------------------------
-- Expose the device helper so scripts using the library can branch on it too.
Library.Device = Device

function Library:Destroy()
    for _, w in ipairs(self.Windows or {}) do
        pcall(function() w:Destroy() end)
    end
    if NotifHolder and NotifHolder.Parent then
        NotifHolder.Parent:Destroy()
    end
    if OverlayGui and OverlayGui.Parent then
        OverlayGui:Destroy()
    end
    self.Windows = {}
end

return Library
