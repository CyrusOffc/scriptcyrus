local function CreateButton(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local row, titleLabel = BaseRow(parent, config.Title, config.Description)

    local btn = Create("TextButton", {
        Text = config.ButtonText or "Run",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(15, 15, 20),
        BackgroundColor3 = theme.Gold,
        Size = mobile and UDim2.fromOffset(96, 40) or UDim2.fromOffset(90, 32),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false,
        Parent = row,
    })
    Utility.Corner(btn, 9)
    Utility.Ripple(btn, Color3.new(1,1,1))
    Utility.PressFeedback(btn, 0.06)
    Themed(btn, function(t) btn.BackgroundColor3 = t.Gold end)

    if not mobile then
        btn.MouseEnter:Connect(function()
            Utility.Tween(btn, 0.15, {BackgroundColor3 = theme.GoldDark})
        end)
        btn.MouseLeave:Connect(function()
            Utility.Tween(btn, 0.15, {BackgroundColor3 = theme.Gold})
        end)
    end

    local Obj = {Instance = row}
    btn.MouseButton1Click:Connect(function()
        if config.Callback then task.spawn(config.Callback) end
    end)
    function Obj:SetTitle(t) titleLabel.Text = t end
    function Obj:SetText(t) btn.Text = t end
    return Utility.Finalize(Obj)
end

----------------------------------------------------------------------
-- TOGGLE (bigger tap target on mobile)
----------------------------------------------------------------------
local function CreateToggle(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local row, titleLabel = BaseRow(parent, config.Title, config.Description)
    local state = config.Default or false

    local trackSize = mobile and UDim2.fromOffset(48, 26) or UDim2.fromOffset(42, 22)
    local knobSize = mobile and 18 or 16
    local knobOnX = mobile and 25 or 23

    local track = Create("Frame", {
        BackgroundColor3 = theme.Elevated,
        Size = trackSize,
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        Parent = row,
    })
    Utility.Corner(track, 999)
    local trackStroke = Utility.Stroke(track, theme.Border, 1, 0.4)
    Themed(track, function(t)
        track.BackgroundColor3 = state and t.Accent or t.Elevated
        trackStroke.Color = t.Border
    end)

    local knob = Create("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        Size = UDim2.fromOffset(knobSize, knobSize),
        Position = state and UDim2.fromOffset(knobOnX, 3) or UDim2.fromOffset(3, 3),
        Parent = track,
    })
    Utility.Corner(knob, 999)

    local function paint()
        if state then
            Utility.Tween(track, 0.2, {BackgroundColor3 = theme.Accent})
            Utility.Tween(knob, 0.2, {Position = UDim2.fromOffset(knobOnX, 3)})
        else
            Utility.Tween(track, 0.2, {BackgroundColor3 = theme.Elevated})
            Utility.Tween(knob, 0.2, {Position = UDim2.fromOffset(3, 3)})
        end
    end

    -- click hitbox extends past the visual track so it's a real 44px target
    -- on phones, per mobile touch-target guidelines.
    local click = Create("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = mobile and UDim2.new(1, 24, 1, 24) or UDim2.new(1,0,1,0),
        Position = mobile and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0,0,0,0),
        AnchorPoint = mobile and Vector2.new(0.5, 0.5) or Vector2.new(0,0),
        Parent = track,
    })

    local Obj = {Instance = row}
    local function set(v, fire)
        state = v
        paint()
        Library.Flags[config.Title] = state
        if fire ~= false and config.Callback then task.spawn(config.Callback, state) end
    end
    click.MouseButton1Click:Connect(function() set(not state) end)
    paint()

    function Obj:Set(v) set(v, true) end
    function Obj:Get() return state end
    function Obj:SetTitle(t) titleLabel.Text = t end

    Library.Elements[config.Title] = Obj
    if config.Default ~= nil then Library.Flags[config.Title] = state end
    return Utility.Finalize(Obj)
end

----------------------------------------------------------------------
-- SLIDER (taller drag bar + bigger knob on touch)
----------------------------------------------------------------------
local function CreateSlider(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local min = config.Min or 0
    local max = config.Max or 100
    local value = math.clamp(config.Default or min, min, max)

    local row, titleLabel = BaseRow(parent, config.Title, config.Description, mobile and 68 or 62)

    local valueLabel = Create("TextLabel", {
        Text = tostring(value),
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = theme.Gold,
        BackgroundColor3 = theme.Elevated,
        Size = UDim2.fromOffset(60, 22),
        Position = UDim2.new(1, -14, 0, 8),
        AnchorPoint = Vector2.new(1, 0),
        Parent = row,
    })
    Utility.Corner(valueLabel, 6)
    Themed(valueLabel, function(t)
        valueLabel.BackgroundColor3 = t.Elevated
        valueLabel.TextColor3 = t.Gold
    end)

    local barHeight = mobile and 10 or 6
    local bar = Create("Frame", {
        BackgroundColor3 = theme.Elevated,
        Size = UDim2.new(1, -28, 0, barHeight),
        Position = UDim2.new(0, 14, 1, mobile and -22 or -18),
        Parent = row,
    })
    Utility.Corner(bar, 999)
    Themed(bar, function(t) bar.BackgroundColor3 = t.Elevated end)

    local fill = Create("Frame", {
        BackgroundColor3 = theme.Accent,
        Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0),
        Parent = bar,
    })
    Utility.Corner(fill, 999)
    local grad = Utility.Gradient(fill, ColorSequence.new(theme.Accent, theme.Gold))
    Themed(fill, function(t)
        grad.Color = ColorSequence.new(t.Accent, t.Gold)
    end)

    local knobSize = mobile and 20 or 14
    local knob = Create("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        Size = UDim2.fromOffset(knobSize, knobSize),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0),
        Parent = bar,
    })
    Utility.Corner(knob, 999)
    Utility.Stroke(knob, theme.Accent, 2)

    local dragging = false
    local function update(px)
        local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        Library.Flags[config.Title] = value
        if config.Callback then task.spawn(config.Callback, value) end
    end

    -- the whole row (not just the thin bar) accepts touch-down on mobile so
    -- fingers don't need pixel-perfect accuracy on a 6-10px bar.
    local hit = mobile and row or bar
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local Obj = {Instance = row}
    function Obj:Set(v)
        v = math.clamp(v, min, max)
        local rel = (v - min) / math.max(max - min, 1)
        value = v
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = tostring(v)
        Library.Flags[config.Title] = v
    end
    function Obj:Get() return value end

    Library.Elements[config.Title] = Obj
    Library.Flags[config.Title] = value
    return Utility.Finalize(Obj)
end

----------------------------------------------------------------------
-- DROPDOWN (screen-aware popup, bigger rows on touch)
----------------------------------------------------------------------
local ActiveDropdownClose = nil

local function CreateDropdown(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local options = config.Options or {}
    local selected = config.Default or options[1]

    local row = BaseRow(parent, config.Title, config.Description, mobile and 58 or 52)

    local boxW = mobile and 150 or 160
    local box = Create("TextButton", {
        Text = "",
        BackgroundColor3 = theme.Elevated,
        Size = UDim2.fromOffset(boxW, mobile and 36 or 30),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false,
        Parent = row,
    })
    Utility.Corner(box, 8)
    local boxStroke = Utility.Stroke(box, theme.Border, 1, 0.4)
    Themed(box, function(t)
        box.BackgroundColor3 = t.Elevated
        boxStroke.Color = t.Border
    end)

    local selLabel = Create("TextLabel", {
        Text = tostring(selected or "Select..."),
        Font = Enum.Font.Gotham, TextSize = mobile and 14 or 13,
        TextColor3 = theme.Text, BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -32, 1, 0),
        Parent = box,
    })
    Themed(selLabel, function(t) selLabel.TextColor3 = t.Text end)

    local arrow = Create("TextLabel", {
        Text = "▾", Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = theme.Gold, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -24, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Parent = box,
    })
    Themed(arrow, function(t) arrow.TextColor3 = t.Gold end)

    local Obj = {Instance = row}
    local popup

    local function closePopup()
        if popup then
            Utility.Tween(popup, 0.15, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            for _, c in ipairs(popup:GetChildren()) do
                if c:IsA("TextButton") or c:IsA("ScrollingFrame") then
                    Utility.Tween(c, 0.12, {BackgroundTransparency = 1})
                end
            end
            local p = popup
            task.delay(0.16, function()
                if p and p.Parent then p:Destroy() end
            end)
            popup = nil
        end
        Utility.Tween(arrow, 0.2, {Rotation = 0})
        if ActiveDropdownClose == closePopup then ActiveDropdownClose = nil end
    end

    local rowH = mobile and 38 or 30

    local function openPopup()
        if ActiveDropdownClose then ActiveDropdownClose() end
        ActiveDropdownClose = closePopup

        local overlay = GetOverlay()
        local pos = box.AbsolutePosition
        local size = box.AbsoluteSize

        local maxHeight = mobile and 260 or 200
        local targetH = math.min(#options * rowH + 8, maxHeight)
        local viewport = Device.GetViewport()
        local spaceBelow = viewport.Y - (pos.Y + size.Y + 6)
        local openUpward = spaceBelow < targetH and pos.Y > targetH
        local popupY = openUpward and (pos.Y - targetH - 6) or (pos.Y + size.Y + 6)
        -- keep popup on-screen horizontally too (important on narrow phones)
        local popupX = math.clamp(pos.X, 6, viewport.X - size.X - 6)

        popup = Create("Frame", {
            BackgroundColor3 = theme.Elevated,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(popupX, popupY),
            Size = UDim2.fromOffset(size.X, 0),
            ZIndex = 999,
            Parent = overlay,
        })
        Utility.Corner(popup, 8)
        Utility.Stroke(popup, theme.Border, 1, 0.3)

        local blocker = Create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.new(1000, 0, 1000, 0),
            Position = UDim2.new(-500, 0, -500, 0),
            ZIndex = -1,
            Parent = popup,
        })
        blocker.MouseButton1Click:Connect(closePopup)

        local scroll = Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = mobile and 5 or 3,
            ScrollBarImageColor3 = theme.Gold,
            ZIndex = 1000,
            Parent = popup,
        })
        Utility.Padding(scroll, 4, 4, 4, 4)
        Utility.ListLayout(scroll, Enum.FillDirection.Vertical, 2)

        for _, opt in ipairs(options) do
            local isSel = (opt == selected)
            local optBtn = Create("TextButton", {
                Text = tostring(opt),
                Font = Enum.Font.Gotham,
                TextSize = mobile and 14 or 13,
                TextColor3 = isSel and theme.Gold or theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = isSel and theme.Accent or theme.Elevated,
                BackgroundTransparency = isSel and 0.85 or 1,
                Size = UDim2.new(1, 0, 0, rowH - 2),
                AutoButtonColor = false,
                ZIndex = 1001,
                Parent = scroll,
            })
            Utility.Corner(optBtn, 6)
            Utility.Padding(optBtn, 0, 10, 0, 10)

            if not mobile then
                optBtn.MouseEnter:Connect(function()
                    Utility.Tween(optBtn, 0.12, {BackgroundTransparency = 0.75, BackgroundColor3 = theme.Accent})
                end)
                optBtn.MouseLeave:Connect(function()
                    Utility.Tween(optBtn, 0.12, {BackgroundTransparency = 1})
                end)
            end

            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                selLabel.Text = tostring(opt)
                Library.Flags[config.Title] = opt
                closePopup()
                if config.Callback then task.spawn(config.Callback, opt) end
            end)
        end

        Utility.Tween(popup, 0.2, {Size = UDim2.fromOffset(size.X, targetH), Position = UDim2.fromOffset(popupX, popupY)}, Enum.EasingStyle.Quart)
        Utility.Tween(popup, 0.15, {BackgroundTransparency = 0})
        Utility.Tween(arrow, 0.2, {Rotation = openUpward and 0 or 180})
    end

    box.MouseButton1Click:Connect(function()
        if popup then closePopup() else openPopup() end
    end)

    function Obj:Set(v)
        selected = v
        selLabel.Text = tostring(v)
        Library.Flags[config.Title] = v
    end
    function Obj:Get() return selected end
    function Obj:Refresh(newOptions)
        options = newOptions
    end

    Library.Elements[config.Title] = Obj
    Library.Flags[config.Title] = selected
    return Utility.Finalize(Obj)
end

----------------------------------------------------------------------
-- MULTI DROPDOWN
----------------------------------------------------------------------
local function CreateMultiDropdown(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local options = config.Options or {}
    local selected = {}
    for _, v in ipairs(config.Default or {}) do selected[v] = true end

    local row = BaseRow(parent, config.Title, config.Description, mobile and 58 or 52)

    local box = Create("TextButton", {
        Text = "", BackgroundColor3 = theme.Elevated,
        Size = UDim2.fromOffset(mobile and 150 or 160, mobile and 36 or 30),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false, Parent = row,
    })
    Utility.Corner(box, 8)
    local boxStroke = Utility.Stroke(box, theme.Border, 1, 0.4)
    Themed(box, function(t)
        box.BackgroundColor3 = t.Elevated
        boxStroke.Color = t.Border
    end)

    local function countText()
        local n = 0
        for _ in pairs(selected) do n += 1 end
        return n == 0 and "Select..." or (n .. " selected")
    end

    local selLabel = Create("TextLabel", {
        Text = countText(),
        Font = Enum.Font.Gotham, TextSize = mobile and 14 or 13, TextColor3 = theme.Text,
        BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -32, 1, 0),
        Parent = box,
    })
    Themed(selLabel, function(t) selLabel.TextColor3 = t.Text end)

    local arrow = Create("TextLabel", {
        Text = "▾", Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = theme.Gold, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -24, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5), Parent = box,
    })
    Themed(arrow, function(t) arrow.TextColor3 = t.Gold end)

    local Obj = {Instance = row}
    local popup

    local function closePopup()
        if popup then
            local p = popup
            Utility.Tween(p, 0.15, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.16, function() if p and p.Parent then p:Destroy() end end)
            popup = nil
        end
        Utility.Tween(arrow, 0.2, {Rotation = 0})
        if ActiveDropdownClose == closePopup then ActiveDropdownClose = nil end
    end

    local function fire()
        local out = {}
        for k in pairs(selected) do out[#out+1] = k end
        Library.Flags[config.Title] = out
        selLabel.Text = countText()
        if config.Callback then task.spawn(config.Callback, out) end
    end

    local rowH = mobile and 38 or 30

    local function openPopup()
        if ActiveDropdownClose then ActiveDropdownClose() end
        ActiveDropdownClose = closePopup

        local overlay = GetOverlay()
        local pos = box.AbsolutePosition
        local size = box.AbsoluteSize

        local maxHeight = mobile and 260 or 200
        local targetH = math.min(#options * rowH + 8, maxHeight)
        local viewport = Device.GetViewport()
        local spaceBelow = viewport.Y - (pos.Y + size.Y + 6)
        local openUpward = spaceBelow < targetH and pos.Y > targetH
        local popupY = openUpward and (pos.Y - targetH - 6) or (pos.Y + size.Y + 6)
        local popupX = math.clamp(pos.X, 6, viewport.X - size.X - 6)

        popup = Create("Frame", {
            BackgroundColor3 = theme.Elevated,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(popupX, popupY),
            Size = UDim2.fromOffset(size.X, 0),
            ZIndex = 999, Parent = overlay,
        })
        Utility.Corner(popup, 8)
        Utility.Stroke(popup, theme.Border, 1, 0.3)

        local blocker = Create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.new(1000, 0, 1000, 0),
            Position = UDim2.new(-500, 0, -500, 0),
            ZIndex = -1, Parent = popup,
        })
        blocker.MouseButton1Click:Connect(closePopup)

        local scroll = Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = mobile and 5 or 3,
            ScrollBarImageColor3 = theme.Gold,
            ZIndex = 1000, Parent = popup,
        })
        Utility.Padding(scroll, 4, 4, 4, 4)
        Utility.ListLayout(scroll, Enum.FillDirection.Vertical, 2)

        for _, opt in ipairs(options) do
            local optBtn = Create("TextButton", {
                Text = "", BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, rowH - 2),
                ZIndex = 1001, Parent = scroll,
            })

            local check = Create("Frame", {
                BackgroundColor3 = selected[opt] and theme.Accent or theme.Secondary,
                Size = UDim2.fromOffset(mobile and 20 or 16, mobile and 20 or 16),
                Position = UDim2.new(0, 8, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                ZIndex = 1002, Parent = optBtn,
            })
            Utility.Corner(check, 4)
            Utility.Stroke(check, theme.Border, 1, 0.3)

            local lbl = Create("TextLabel", {
                Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = mobile and 14 or 13,
                TextColor3 = theme.SubText, BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, 34, 0, 0),
                Size = UDim2.new(1, -38, 1, 0),
                ZIndex = 1002, Parent = optBtn,
            })

            if not mobile then
                optBtn.MouseEnter:Connect(function()
                    Utility.Tween(lbl, 0.12, {TextColor3 = theme.Text})
                end)
                optBtn.MouseLeave:Connect(function()
                    Utility.Tween(lbl, 0.12, {TextColor3 = theme.SubText})
                end)
            end

            optBtn.MouseButton1Click:Connect(function()
                selected[opt] = not selected[opt] or nil
                check.BackgroundColor3 = selected[opt] and theme.Accent or theme.Secondary
                lbl.TextColor3 = selected[opt] and theme.Text or theme.SubText
                fire()
            end)
        end

        Utility.Tween(popup, 0.2, {Size = UDim2.fromOffset(size.X, targetH), Position = UDim2.fromOffset(popupX, popupY)}, Enum.EasingStyle.Quart)
        Utility.Tween(popup, 0.15, {BackgroundTransparency = 0})
        Utility.Tween(arrow, 0.2, {Rotation = openUpward and 0 or 180})
    end

    box.MouseButton1Click:Connect(function()
        if popup then closePopup() else openPopup() end
    end)

    function Obj:Get()
        local out = {}
        for k in pairs(selected) do out[#out+1] = k end
        return out
    end
    function Obj:Set(list)
        selected = {}
        for _, v in ipairs(list) do selected[v] = true end
        fire()
    end
    function Obj:Refresh(newOptions) options = newOptions end

    Library.Elements[config.Title] = Obj
    return Utility.Finalize(Obj)
end

