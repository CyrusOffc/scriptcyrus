local function CreateColorPicker(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local row = BaseRow(parent, config.Title, config.Description)
    local color = config.Default or Color3.fromRGB(64, 150, 255)

    local preview = Create("TextButton", {
        Text = "",
        BackgroundColor3 = color,
        Size = UDim2.fromOffset(mobile and 56 or 50, mobile and 32 or 26),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false,
        Parent = row,
    })
    Utility.Corner(preview, 6)
    Utility.Stroke(preview, theme.Border, 1, 0.3)

    local popup
    local function closePopup()
        if popup then
            local p = popup
            Utility.Tween(p, 0.15, {BackgroundTransparency = 1})
            task.delay(0.16, function() if p and p.Parent then p:Destroy() end end)
            popup = nil
        end
        if ActiveDropdownClose == closePopup then ActiveDropdownClose = nil end
    end

    local function openPopup()
        if ActiveDropdownClose then ActiveDropdownClose() end
        ActiveDropdownClose = closePopup

        local overlay = GetOverlay()
        local pos = preview.AbsolutePosition
        local popupW = mobile and 220 or 190
        local popupH = mobile and 150 or 130
        local viewport = Device.GetViewport()
        local spaceBelow = viewport.Y - (pos.Y + preview.AbsoluteSize.Y + 6)
        local openUpward = spaceBelow < popupH and pos.Y > popupH
        local popupY = openUpward and (pos.Y - popupH - 6) or (pos.Y + preview.AbsoluteSize.Y + 6)
        local popupX = math.clamp(pos.X - popupW + preview.AbsoluteSize.X, 6, viewport.X - popupW - 6)
        popup = Create("Frame", {
            BackgroundColor3 = theme.Elevated,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(popupX, popupY),
            Size = UDim2.fromOffset(popupW, popupH),
            ZIndex = 999, Parent = overlay,
        })
        Utility.Corner(popup, 8)
        Utility.Stroke(popup, theme.Border, 1, 0.3)
        Utility.Padding(popup, 8, 8, 8, 8)

        local blocker = Create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.new(1000, 0, 1000, 0),
            Position = UDim2.new(-500, 0, -500, 0),
            ZIndex = -1, Parent = popup,
        })
        blocker.MouseButton1Click:Connect(closePopup)

        local channels = {
            {name = "R", val = math.floor(color.R * 255), col = Color3.fromRGB(255,80,80)},
            {name = "G", val = math.floor(color.G * 255), col = Color3.fromRGB(80,255,80)},
            {name = "B", val = math.floor(color.B * 255), col = Color3.fromRGB(80,80,255)},
        }

        local function applyColor()
            color = Color3.fromRGB(channels[1].val, channels[2].val, channels[3].val)
            preview.BackgroundColor3 = color
            Library.Flags[config.Title] = color
            if config.Callback then task.spawn(config.Callback, color) end
        end

        local barH = mobile and 26 or 20
        local barGap = mobile and 34 or 30
        for i, ch in ipairs(channels) do
            local bar = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, 0, 0, barH),
                Position = UDim2.new(0, 0, 0, (i-1) * (barGap + 8)),
                ZIndex = 1000, Parent = popup,
            })
            Utility.Corner(bar, 5)

            local fill = Create("Frame", {
                BackgroundColor3 = ch.col,
                Size = UDim2.new(ch.val/255, 0, 1, 0),
                ZIndex = 1001, Parent = bar,
            })
            Utility.Corner(fill, 5)

            local valLbl = Create("TextLabel", {
                Text = tostring(ch.val),
                Font = Enum.Font.GothamBold, TextSize = 11,
                TextColor3 = theme.Text, BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Right,
                Size = UDim2.new(1, -6, 1, 0), Position = UDim2.new(0, 0, 0, 0),
                ZIndex = 1002, Parent = bar,
            })

            local lbl = Create("TextLabel", {
                Text = ch.name,
                Font = Enum.Font.GothamBold, TextSize = 11,
                TextColor3 = ch.col, BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, 6, 0, 0),
                Size = UDim2.new(1, -12, 1, 0),
                ZIndex = 1002, Parent = bar,
            })

            local dragging = false
            local function update(px)
                local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                ch.val = math.floor(rel * 255 + 0.5)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                valLbl.Text = tostring(ch.val)
                applyColor()
            end
            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    update(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    update(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        Utility.Tween(popup, 0.2, {BackgroundTransparency = 0})
    end

    preview.MouseButton1Click:Connect(function()
        if popup then closePopup() else openPopup() end
    end)

    local Obj = {Instance = row}
    function Obj:Set(c)
        color = c
        preview.BackgroundColor3 = c
        Library.Flags[config.Title] = c
    end
    function Obj:Get() return color end
    Library.Elements[config.Title] = Obj
    Library.Flags[config.Title] = color
    return Utility.Finalize(Obj)
end

