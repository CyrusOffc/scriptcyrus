----------------------------------------------------------------------
-- ELEMENT BASE ROW (responsive: taller rows + bigger text on touch)
----------------------------------------------------------------------
local function BaseRow(parent, title, desc, height)
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    height = height or (desc and (mobile and 58 or 52) or (mobile and 50 or 44))

    local row = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, height),
        Parent = parent,
    })
    Utility.Corner(row, 10)
    local stroke = Utility.Stroke(row, theme.Border, 1, 0.65)
    Themed(row, function(t)
        row.BackgroundColor3 = t.Secondary
        stroke.Color = t.Border
    end)

    -- accent dot
    local dot = Create("Frame", {
        BackgroundColor3 = theme.Gold,
        Size = UDim2.fromOffset(6, 6),
        Position = UDim2.new(0, 14, 0.5, desc and -6 or 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Parent = row,
    })
    Utility.Corner(dot, 999)
    Themed(dot, function(t) dot.BackgroundColor3 = t.Gold end)

    local titleLabel = Create("TextLabel", {
        Text = title or "",
        Font = Enum.Font.GothamBold,
        TextSize = mobile and 15 or 14,
        TextColor3 = theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = desc and UDim2.new(0, 30, 0, 8) or UDim2.new(0, 30, 0.5, 0),
        Size = desc and UDim2.new(1, -190, 0, 18) or UDim2.new(1, -190, 0, 20),
        AnchorPoint = desc and Vector2.new(0, 0) or Vector2.new(0, 0.5),
        Parent = row,
    })
    Themed(titleLabel, function(t) titleLabel.TextColor3 = t.Text end)

    local descLabel
    if desc then
        descLabel = Create("TextLabel", {
            Text = desc,
            Font = Enum.Font.Gotham,
            TextSize = mobile and 13 or 12,
            TextColor3 = theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 30, 0, 28),
            Size = UDim2.new(1, -190, 0, 18),
            Parent = row,
        })
        Themed(descLabel, function(t) descLabel.TextColor3 = t.SubText end)
    end

    return row, titleLabel, descLabel
end

