local function NewTab(window, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = window.MobileLayout

    local entry, indicator, icon, label

    if mobile then
        -- Bottom bar item: icon on top, tiny label under it, square-ish
        -- hit area sized for a thumb.
        entry = Create("TextButton", {
            Text = "",
            BackgroundColor3 = theme.Elevated,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 64, 1, 0),
            AutoButtonColor = false,
            Parent = window.TabList,
        })
        Utility.Corner(entry, 12)

        indicator = Create("Frame", {
            BackgroundColor3 = theme.Gold,
            Size = UDim2.new(0.5, 0, 0, 3),
            Position = UDim2.new(0.5, 0, 0, 2),
            AnchorPoint = Vector2.new(0.5, 0),
            Visible = false,
            Parent = entry,
        })
        Utility.Corner(indicator, 999)
        Themed(indicator, function(t) indicator.BackgroundColor3 = t.Gold end)

        icon = Create("TextLabel", {
            Text = config.Icon or "●",
            Font = Enum.Font.GothamBold, TextSize = 16,
            TextColor3 = theme.SubText, BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 22),
            Position = UDim2.new(0, 0, 0, 10),
            Parent = entry,
        })

        label = Create("TextLabel", {
            Text = config.Title or "Tab",
            Font = Enum.Font.GothamMedium, TextSize = 10,
            TextColor3 = theme.SubText, BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 2, 0, 34),
            Size = UDim2.new(1, -4, 0, 14),
            Parent = entry,
        })
    else
        entry = Create("TextButton", {
            Text = "",
            BackgroundColor3 = theme.Elevated,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 38),
            AutoButtonColor = false,
            Parent = window.TabList,
        })
        Utility.Corner(entry, 8)

        indicator = Create("Frame", {
            BackgroundColor3 = theme.Gold,
            Size = UDim2.new(0, 3, 0.55, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Visible = false,
            Parent = entry,
        })
        Utility.Corner(indicator, 999)
        Themed(indicator, function(t) indicator.BackgroundColor3 = t.Gold end)

        icon = Create("TextLabel", {
            Text = config.Icon or "●",
            Font = Enum.Font.GothamBold, TextSize = 12,
            TextColor3 = theme.SubText, BackgroundTransparency = 1,
            Size = UDim2.fromOffset(20, 20),
            Position = UDim2.new(0, 14, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            Parent = entry,
        })

        label = Create("TextLabel", {
            Text = config.Title or "Tab",
            Font = Enum.Font.GothamMedium, TextSize = 13,
            TextColor3 = theme.SubText, BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 44, 0, 0),
            Size = UDim2.new(1, -50, 1, 0),
            Parent = entry,
        })
    end

    local page = Create("ScrollingFrame", {
        BackgroundTransparency = 1,
        Visible = false,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = mobile and 5 or 4,
        ScrollBarImageColor3 = theme.Gold,
        ScrollBarImageTransparency = 0.3,
        Parent = window.PageHolder,
    })
    Utility.Padding(page, 12, 12, 12, 12)
    Utility.ListLayout(page, Enum.FillDirection.Vertical, 12)

    local self = setmetatable({
        Instance = page, Entry = entry, Label = label,
        Icon = icon, Indicator = indicator,
        Window = window, Title = config.Title,
    }, Tab)

    local function paint(active)
        Utility.Tween(entry, 0.15, {
            BackgroundTransparency = active and 0 or 1,
            BackgroundColor3 = theme.Accent,
        })
        Utility.Tween(label, 0.15, {TextColor3 = active and theme.Text or theme.SubText})
        Utility.Tween(icon, 0.15, {TextColor3 = active and theme.Gold or theme.SubText})
        indicator.Visible = active
        if active then
            if mobile then
                indicator.Size = UDim2.new(0, 0, 0, 3)
                Utility.Tween(indicator, 0.2, {Size = UDim2.new(0.5, 0, 0, 3)})
            else
                indicator.Size = UDim2.new(0, 0, 0.55, 0)
                Utility.Tween(indicator, 0.2, {Size = UDim2.new(0, 3, 0.55, 0)})
            end
        end
    end
    self.Paint = paint
    paint(false)

    if not mobile then
        entry.MouseEnter:Connect(function()
            if window.Selected ~= config.Title then
                Utility.Tween(entry, 0.15, {BackgroundTransparency = 0.7})
            end
        end)
        entry.MouseLeave:Connect(function()
            if window.Selected ~= config.Title then
                Utility.Tween(entry, 0.15, {BackgroundTransparency = 1})
            end
        end)
    end

    Utility.PressFeedback(entry, 0.05)

    entry.MouseButton1Click:Connect(function()
        window:SelectTab(config.Title)
    end)

    window.Tabs[config.Title] = self
    if not window.FirstTab then window.FirstTab = config.Title end
    return self
end

for name, fn in pairs(ElementMixins) do
    Tab[name] = function(self, config) return fn(self.Instance, config) end
end

function Tab:CreateSection(config)
    return NewSection(self.Instance, config)
end

