----------------------------------------------------------------------
-- KEYBIND (auto-warns / hides on mobile since there's no keyboard)
----------------------------------------------------------------------
local function CreateKeybind(parent, config)
    config = config or {}
    local theme = Library.CurrentTheme
    local mobile = Device.GetClass() ~= "Desktop"
    local row = BaseRow(parent, config.Title, config.Description)
    local current = config.Default or Enum.KeyCode.F

    local btn = Create("TextButton", {
        Text = mobile and "N/A" or current.Name,
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = theme.Gold,
        BackgroundColor3 = theme.Elevated,
        Size = UDim2.fromOffset(90, mobile and 36 or 30),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        AutoButtonColor = false,
        Active = not mobile,
        Parent = row,
    })
    Utility.Corner(btn, 8)
    local btnStroke = Utility.Stroke(btn, theme.Border, 1, 0.4)
    Themed(btn, function(t)
        btn.BackgroundColor3 = t.Elevated
        btnStroke.Color = t.Border
        btn.TextColor3 = t.Gold
    end)

    if mobile then
        -- No physical keyboard on touch devices: keep the row visible for
        -- layout/config consistency but make it a no-op instead of a
        -- confusing "..." state that can never be filled in.
        local Obj = {Instance = row}
        function Obj:Set(k) current = k end
        function Obj:Get() return current end
        Library.Elements[config.Title] = Obj
        return Utility.Finalize(Obj)
    end

    local listening = false
    local connection
    local function stopListening()
        listening = false
        if connection then connection:Disconnect(); connection = nil end
    end
    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "..."
        connection = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    btn.Text = current.Name
                    stopListening()
                    return
                end
                current = input.KeyCode
                btn.Text = current.Name
                Library.Flags[config.Title] = current
                if config.Callback then task.spawn(config.Callback, current) end
                stopListening()
            end
        end)
    end)

    local Obj = {Instance = row}
    function Obj:Set(k)
        current = k
        btn.Text = k.Name
        Library.Flags[config.Title] = k
    end
    function Obj:Get() return current end
    Library.Elements[config.Title] = Obj
    return Utility.Finalize(Obj)
end

