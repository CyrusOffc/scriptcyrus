----------------------------------------------------------------------
function Library:SaveConfig(name)
	name = name or "default"
	local ok = pcall(function()
		if not isfolder or not isfolder("CyrusHub") then
			if makefolder then makefolder("CyrusHub") end
		end
		writefile("CyrusHub/" .. name .. ".json", HttpService:JSONEncode(self.Flags))
	end)
	return ok
end

function Library:LoadConfig(name)
	name = name or "default"
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile("CyrusHub/" .. name .. ".json"))
	end)
	if not ok or type(data) ~= "table" then return false end
	for title, value in pairs(data) do
		local el = self.Elements[title]
		if el and el.Set then
			pcall(function() el:Set(value) end)
		end
	end
	return true
end

