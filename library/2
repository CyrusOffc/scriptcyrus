		TextColor3 = theme.SubText, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 38, 0, 0), Size = UDim2.new(1, -44, 1, 0),
		Parent = entry,
	})

	-- content page
	local page = Create("ScrollingFrame", {
		BackgroundTransparency = 1, Visible = false,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0,0,0,0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Gold,
		Parent = window.PageHolder,
	})
	Utility.Padding(page, 4, 4, 4, 4)
	Utility.ListLayout(page, Enum.FillDirection.Vertical, 10)

	local self = setmetatable({
		Instance = page, Entry = entry, Label = label, Icon = icon, Window = window,
		Title = config.Title,
	}, Tab)

	local function paint(active)
		Utility.Tween(entry, 0.15, {BackgroundTransparency = active and 0 or 1, BackgroundColor3 = theme.Accent})
		Utility.Tween(label, 0.15, {TextColor3 = active and theme.Text or theme.SubText})
	end
	self.Paint = paint
	paint(false)

	entry.MouseButton1Click:Connect(function()
		window:SelectTab(config.Title)
	end)

	window.Tabs[config.Title] = self
	if not window.FirstTab then window.FirstTab = config.Title end
	return self
end

for name, fn in pairs(ElementMixins) do
	Tab[name] = function(self, config) return fn(self.Instance, config) end
end

function Tab:CreateSection(config)
	return NewSection(self.Instance, config)
end

