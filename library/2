local function CreateSlider(parent, config)
	config = config or {}
	local theme = Library.CurrentTheme
	local min, max = config.Min or 0, config.Max or 100
	local value = math.clamp(config.Default or min, min, max)

	local row = BaseRow(parent, config.Title, config.Description, 58)
	local titleLabel = row:FindFirstChildOfClass("TextLabel")

	local valueLabel = Create("TextLabel", {
		Text = tostring(value),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = theme.Gold,
		BackgroundColor3 = theme.Elevated,
		Size = UDim2.fromOffset(56, 22),
		Position = UDim2.new(1, -14, 0, 6),
		AnchorPoint = Vector2.new(1, 0),
		Parent = row,
	})
	Utility.Corner(valueLabel, 6)
	Themed(valueLabel, function(t) valueLabel.BackgroundColor3 = t.Elevated valueLabel.TextColor3 = t.Gold end)

	local bar = Create("Frame", {
		BackgroundColor3 = theme.Elevated,
		Size = UDim2.new(1, -28, 0, 6),
		Position = UDim2.new(0, 14, 1, -14),
		Parent = row,
	})
	Utility.Corner(bar, 999)
	Themed(bar, function(t) bar.BackgroundColor3 = t.Elevated end)

	local fill = Create("Frame", {
		BackgroundColor3 = theme.Accent,
		Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0),
		Parent = bar,
	})
	Utility.Corner(fill, 999)
	Utility.Gradient(fill, ColorSequence.new(theme.Accent, theme.Gold))

	local knob = Create("Frame", {
		BackgroundColor3 = Color3.new(1,1,1),
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0),
		Parent = bar,
	})
	Utility.Corner(knob, 999)

	local dragging = false
	local function update(px)
		local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		value = math.floor(min + (max - min) * rel)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueLabel.Text = tostring(value)
		Library.Flags[config.Title] = value
		if config.Callback then task.spawn(config.Callback, value) end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local Obj = {Instance = row}
	function Obj:Set(v)
		v = math.clamp(v, min, max)
		local rel = (v - min) / math.max(max - min, 1)
		value = v
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueLabel.Text = tostring(v)
	end
	function Obj:Get() return value end
	Library.Elements[config.Title] = Obj
	Library.Flags[config.Title] = value
	return Obj
end

