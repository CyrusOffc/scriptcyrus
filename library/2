local function BaseRow(parent, title, desc, height)
	local theme = Library.CurrentTheme
	local row = Create("Frame", {
		BackgroundColor3 = theme.Secondary,
		Size = UDim2.new(1, 0, 0, height or 52),
		Parent = parent,
	})
	Utility.Corner(row, 10)
	local stroke = Utility.Stroke(row, theme.Border, 1, 0.6)

	Themed(row, function(t)
		row.BackgroundColor3 = t.Secondary
		stroke.Color = t.Border
	end)

	local iconDot = Create("Frame", {
		BackgroundColor3 = theme.Accent,
		Size = UDim2.fromOffset(6, 6),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = row,
	})
	Utility.Corner(iconDot, 999)
	Themed(iconDot, function(t) iconDot.BackgroundColor3 = t.Gold end)

	local titleLabel = Create("TextLabel", {
		Text = title or "",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 30, 0, desc and 6 or 0),
		Size = UDim2.new(1, -180, 0, desc and 16 or height or 52),
		Parent = row,
	})
	if not desc then titleLabel.AnchorPoint = Vector2.new(0, 0.5) titleLabel.Position = UDim2.new(0, 30, 0.5, 0) end
	Themed(titleLabel, function(t) titleLabel.TextColor3 = t.Text end)

	local descLabel
	if desc then
		descLabel = Create("TextLabel", {
			Text = desc,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 30, 0, 24),
			Size = UDim2.new(1, -180, 0, 16),
			Parent = row,
		})
		Themed(descLabel, function(t) descLabel.TextColor3 = t.SubText end)
	end

	return row, titleLabel, descLabel
end

