    Themed(pageHolder, function(t)
        pageHolder.BackgroundColor3 = t.Elevated
        phStroke.Color = t.Border
    end)

    -- FLOATING BUTTON (minimized)
    local floatBtn = Create("ImageButton", {
        BackgroundColor3 = theme.Gold, Visible = false,
        Size = UDim2.fromOffset(50, 50),
        Position = UDim2.new(0.5, -25, 0.85, 0),
        AutoButtonColor = false, Parent = screenGui,
    })
    Utility.Corner(floatBtn, 999)
    Utility.Stroke(floatBtn, theme.Accent, 2)
    Create("TextLabel", {
        Text = "☰", Font = Enum.Font.GothamBold, TextSize = 20,
        TextColor3 = Color3.fromRGB(15,15,20), BackgroundTransparency = 1,
        Size = UDim2.new(1,0,1,0), Parent = floatBtn,
    })
    Utility.MakeDraggable(floatBtn)

    -- resize handle (bottom-right)
    local resizeHandle = Create("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -6, 1, -6),
        AnchorPoint = Vector2.new(1, 1),
        Parent = main,
    })
    local resizeGrip = Create("Frame", {
        BackgroundColor3 = theme.Gold,
        BackgroundTransparency = 0.3,
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.new(1, -6, 1, -6),
        AnchorPoint = Vector2.new(1, 1),
        Parent = main,
    })
    Utility.Corner(resizeGrip, 3)

    local self = setmetatable({
        ScreenGui = screenGui, Main = main, Shadow = shadow,
        TabList = tabList, PageHolder = pageHolder,
        Tabs = {}, FirstTab = nil, Minimized = false,
        TargetSize = size, FloatBtn = floatBtn, Topbar = topbar,
        TitleLabel = titleLabel,
    }, Window)

    -- resize logic
    local resizing, resizeStart, startSize
    resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = main.AbsoluteSize
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - resizeStart
            local newW = math.max(480, startSize.X + delta.X)
            local newH = math.max(320, startSize.Y + delta.Y)
            main.Size = UDim2.fromOffset(newW, newH)
            shadow.Size = UDim2.fromOffset(newW, newH)
            self.TargetSize = UDim2.fromOffset(newW, newH)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end)

    -- open animation
    Utility.Tween(main, 0.4, {Size = size}, Enum.EasingStyle.Back)
    Utility.Tween(shadow, 0.4, {Size = size}, Enum.EasingStyle.Back)

    closeBtn.MouseButton1Click:Connect(function() self:Toggle() end)
    minBtn.MouseButton1Click:Connect(function() self:Minimize() end)
    floatBtn.MouseButton1Click:Connect(function() self:Minimize() end)

    Library.ActiveWindow = self
    Library.Windows = Library.Windows or {}
    table.insert(Library.Windows, self)
    return self
end

function Window:CreateTab(config)
    local tab = NewTab(self, config)
    if not self.Selected then self:SelectTab(config.Title) end
    return tab
end

function Window:SelectTab(title)
    local tab = self.Tabs[title]
    if not tab then return end
    for t, other in pairs(self.Tabs) do
        other.Instance.Visible = (t == title)
        other.Paint(t == title)
    end
    self.Selected = title
end

function Window:Toggle()
    local visible = self.Main.Visible
    if visible then
        Utility.Tween(self.Main, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Utility.Tween(self.Shadow, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function()
            self.Main.Visible = false
            self.Shadow.Visible = false
        end)
    else
        self.Main.Visible = true
        self.Shadow.Visible = true
        self.Main.Size = UDim2.fromOffset(0,0)
        Utility.Tween(self.Main, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
        Utility.Tween(self.Shadow, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
    end
end

function Window:Minimize()
    self.Minimized = not self.Minimized
    if self.Minimized then
        Utility.Tween(self.Main, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Utility.Tween(self.Shadow, 0.25, {Size = UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function()
            self.Main.Visible = false
            self.Shadow.Visible = false
            self.FloatBtn.Visible = true
            self.FloatBtn.Size = UDim2.fromOffset(0,0)
            Utility.Tween(self.FloatBtn, 0.25, {Size = UDim2.fromOffset(50,50)}, Enum.EasingStyle.Back)
        end)
    else
        Utility.Tween(self.FloatBtn, 0.2, {Size = UDim2.fromOffset(0,0)})
        task.delay(0.2, function()
            self.FloatBtn.Visible = false
            self.Main.Visible = true
            self.Shadow.Visible = true
            self.Main.Size = UDim2.fromOffset(0,0)
            Utility.Tween(self.Main, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
            Utility.Tween(self.Shadow, 0.3, {Size = self.TargetSize}, Enum.EasingStyle.Back)
        end)
    end
end

function Window:Destroy()
    self.ScreenGui:Destroy()
end

----------------------------------------------------------------------
-- LIBRARY EXTRAS
----------------------------------------------------------------------
function Library:Destroy()
    for _, w in ipairs(self.Windows or {}) do
        pcall(function() w:Destroy() end)
    end
    if NotifHolder and NotifHolder.Parent then
        NotifHolder.Parent:Destroy()
    end
    if OverlayGui and OverlayGui.Parent then
        OverlayGui:Destroy()
    end
    self.Windows = {}
end

return Library
