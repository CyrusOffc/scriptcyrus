local Library = {}
Library.__index = Library
Library.Themes = {}
Library.CurrentThemeName = nil
Library.CurrentTheme = nil
Library.Registry = {}
Library.Flags = {}
Library.Elements = {}
Library.ActiveWindow = nil
Library.Version = "1.3.0"

function Library:RegisterTheme(name, theme)
    self.Themes[name] = theme
    if not self.CurrentTheme then
        self.CurrentTheme = theme
        self.CurrentThemeName = name
    end
end

function Library:SetTheme(name)
    local theme = self.Themes[name]
    if not theme then return end
    self.CurrentTheme = theme
    self.CurrentThemeName = name
    for _, entry in ipairs(self.Registry) do
        if entry.Instance and entry.Instance.Parent then
            pcall(entry.Update, theme)
        end
    end
end

local function Themed(instance, updateFn)
    Library.Registry[#Library.Registry + 1] = {Instance = instance, Update = updateFn}
    updateFn(Library.CurrentTheme)
end

