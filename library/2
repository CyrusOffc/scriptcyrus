	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		checks = {}
		for _, opt in ipairs(options) do
			local optBtn = Create("TextButton", {
				Text = "", BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 26), ZIndex = 6, Parent = list,
			})
			local check = Create("Frame", {
				BackgroundColor3 = selected[opt] and theme.Accent or theme.Secondary,
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
				ZIndex = 7, Parent = optBtn,
			})
			Utility.Corner(check, 4)
			Utility.Stroke(check, theme.Border, 1, 0.3)
			local lbl = Create("TextLabel", {
				Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 13,
				TextColor3 = theme.SubText, BackgroundTransparency = 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 30, 0, 0), Size = UDim2.new(1, -34, 1, 0),
				ZIndex = 7, Parent = optBtn,
			})
			checks[opt] = check
			optBtn.MouseButton1Click:Connect(function()
				selected[opt] = not selected[opt] or nil
				check.BackgroundColor3 = selected[opt] and theme.Accent or theme.Secondary
				selLabel.Text = countText()
				local out = {}
				for k in pairs(selected) do out[#out+1] = k end
				Library.Flags[config.Title] = out
				if config.Callback then task.spawn(config.Callback, out) end
			end)
		end
	end
	rebuild()

	box.MouseButton1Click:Connect(function()
		open = not open
		local target = open and math.min(#options * 28 + 8, 150) or 0
		Utility.Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, target)})
		Utility.Tween(arrow, 0.2, {Rotation = open and 180 or 0})
	end)

	function Obj:Get()
		local out = {}
		for k in pairs(selected) do out[#out+1] = k end
		return out
	end
	function Obj:Refresh(newOptions) options = newOptions rebuild() end
	Library.Elements[config.Title] = Obj
	return Obj
end

