-- DROPDOWN (single select)
----------------------------------------------------------------------
local function CreateDropdown(parent, config)
	config = config or {}
	local theme = Library.CurrentTheme
	local options = config.Options or {}
	local selected = config.Default or options[1]
	local open = false

	local row = BaseRow(parent, config.Title, config.Description, 52)

	local box = Create("TextButton", {
		Text = "",
		BackgroundColor3 = theme.Elevated,
		Size = UDim2.fromOffset(150, 30),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		AutoButtonColor = false,
		Parent = row,
	})
	Utility.Corner(box, 8)
	local boxStroke = Utility.Stroke(box, theme.Border, 1, 0.4)
	Themed(box, function(t) box.BackgroundColor3 = t.Elevated boxStroke.Color = t.Border end)

	local selLabel = Create("TextLabel", {
		Text = tostring(selected or "Select"),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = theme.Text,
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(1, -28, 1, 0),
		Parent = box,
	})
	Themed(selLabel, function(t) selLabel.TextColor3 = t.Text end)

	local arrow = Create("TextLabel", {
		Text = "▾",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = theme.Gold,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, -22, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = box,
	})
	Themed(arrow, function(t) arrow.TextColor3 = t.Gold end)

	local list = Create("Frame", {
		BackgroundColor3 = theme.Elevated,
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 1, 6),
		ClipsDescendants = true,
		ZIndex = 5,
		Parent = box,
	})
	Utility.Corner(list, 8)
	local listStroke = Utility.Stroke(list, theme.Border, 1, 0.3)
	Themed(list, function(t) list.BackgroundColor3 = t.Elevated listStroke.Color = t.Border end)
	local layout = Utility.ListLayout(list, Enum.FillDirection.Vertical, 2)
	Utility.Padding(list, 4)

	local Obj = {Instance = row}

	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, opt in ipairs(options) do
			local optBtn = Create("TextButton", {
				Text = tostring(opt),
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 26),
				ZIndex = 6,
				Parent = list,
			})
			Utility.Padding(optBtn, 0, 8, 0, 8)
			optBtn.MouseButton1Click:Connect(function()
				selected = opt
				selLabel.Text = tostring(opt)
				Library.Flags[config.Title] = opt
				open = false
				Utility.Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
				Utility.Tween(arrow, 0.2, {Rotation = 0})
				if config.Callback then task.spawn(config.Callback, opt) end
			end)
		end
	end
	rebuild()

	box.MouseButton1Click:Connect(function()
		open = not open
		local target = open and math.min(#options * 28 + 8, 150) or 0
		Utility.Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, target)})
		Utility.Tween(arrow, 0.2, {Rotation = open and 180 or 0})
	end)

	function Obj:Set(v) selected = v selLabel.Text = tostring(v) Library.Flags[config.Title] = v end
	function Obj:Get() return selected end
	function Obj:Refresh(newOptions) options = newOptions rebuild() end
	Library.Elements[config.Title] = Obj
	Library.Flags[config.Title] = selected
	return Obj
end

