function Library:Destroy()
	for _, w in ipairs(self.Windows or {}) do
		pcall(function() w:Destroy() end)
	end
	if NotifHolder and NotifHolder.Parent then
		NotifHolder.Parent:Destroy()
	end
	self.Windows = {}
end

return Library
