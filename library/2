----------------------------------------------------------------------
-- UTILITY
----------------------------------------------------------------------
local Utility = {}

function Utility.Create(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end
local Create = Utility.Create

function Utility.Tween(obj, time, props, style, dir)
    style = style or Enum.EasingStyle.Quint
    dir = dir or Enum.EasingDirection.Out
    local tw = TweenService:Create(obj, TweenInfo.new(time, style, dir), props)
    tw:Play()
    return tw
end

function Utility.Corner(parent, radius)
    return Create("UICorner", {CornerRadius = UDim.new(0, radius or 8), Parent = parent})
end

function Utility.Stroke(parent, color, thickness, transparency)
    return Create("UIStroke", {
        Color = color, Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

function Utility.Gradient(parent, colorSeq, rotation, transparencySeq)
    return Create("UIGradient", {
        Color = colorSeq, Rotation = rotation or 0,
        Transparency = transparencySeq, Parent = parent,
    })
end

function Utility.Padding(parent, t, r, b, l)
    return Create("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or (l or t or 0)),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or (r or t or 0)),
        Parent = parent,
    })
end

function Utility.ListLayout(parent, direction, padding, alignX, alignY)
    return Create("UIListLayout", {
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, padding or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = alignX or Enum.HorizontalAlignment.Left,
        VerticalAlignment = alignY or Enum.VerticalAlignment.Top,
        Parent = parent,
    })
end

function Utility.MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function Utility.Ripple(button, color)
    button.ClipsDescendants = true
    button.MouseButton1Down:Connect(function(x, y)
        local rel = Vector2.new(x, y) - Vector2.new(button.AbsolutePosition.X, button.AbsolutePosition.Y)
        local circle = Create("Frame", {
            BackgroundColor3 = color or Color3.new(1,1,1),
            BackgroundTransparency = 0.75,
            Position = UDim2.fromOffset(rel.X, rel.Y),
            Size = UDim2.fromOffset(0, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = button.ZIndex + 1,
            Parent = button,
        })
        Utility.Corner(circle, 999)
        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2
        Utility.Tween(circle, 0.5, {Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1})
        task.delay(0.5, function() circle:Destroy() end)
    end)
end

function Utility.Hover(target, normalColor, hoverColor)
    target.MouseEnter:Connect(function()
        Utility.Tween(target, 0.15, {BackgroundColor3 = hoverColor})
    end)
    target.MouseLeave:Connect(function()
        Utility.Tween(target, 0.15, {BackgroundColor3 = normalColor})
    end)
end

-- Adds a standard :Destroy() and :SetVisible() to any element Obj that has
-- an `Instance` field. Called at the end of every Create* constructor so
-- all elements behave consistently.
function Utility.Finalize(obj)
    if obj.Destroy == nil then
        function obj:Destroy()
            if self.Instance then self.Instance:Destroy() end
        end
    end
    if obj.SetVisible == nil then
        function obj:SetVisible(visible)
            if self.Instance then self.Instance.Visible = visible end
        end
    end
    return obj
end

