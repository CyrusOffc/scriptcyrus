function Library:Notify(config)
    config = config or {}
    EnsureNotifHolder()
    local theme = self.CurrentTheme

    local card = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(1, 60, 0, 0),
        Parent = NotifHolder,
    })
    Utility.Corner(card, 10)
    local strokeColor = (config.Type == "success" and theme.Success)
                     or (config.Type == "error" and theme.Error)
                     or (config.Type == "warning" and theme.Warning)
                     or theme.Gold
    Utility.Stroke(card, strokeColor, 1, 0.3)
    Utility.Padding(card, 12, 12, 14, 12)

    -- accent bar left
    local accent = Create("Frame", {
        BackgroundColor3 = strokeColor,
        Size = UDim2.new(0, 3, 1, -24),
        Position = UDim2.new(0, 0, 0, 0),
        Parent = card,
    })
    Utility.Corner(accent, 999)

    local titleRow = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 8, 0, 0),
        Parent = card,
    })
    Create("TextLabel", {
        Text = config.Title or "Notification",
        Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = theme.Text,
        BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 1, 0), Parent = titleRow,
    })

    Create("TextLabel", {
        Text = config.Description or "", RichText = true,
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = theme.SubText,
        BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, Position = UDim2.new(0, 8, 0, 22),
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    })

    local bar = Create("Frame", {
        BackgroundColor3 = strokeColor,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, 0),
        Parent = card,
    })

    Utility.Tween(card, 0.35, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)

    local duration = config.Duration or 5
    Utility.Tween(bar, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        Utility.Tween(card, 0.3, {Position = UDim2.new(1, 60, 0, 0)})
        task.delay(0.3, function() card:Destroy() end)
    end)
end

----------------------------------------------------------------------
-- CONFIG MANAGER
----------------------------------------------------------------------
function Library:SaveConfig(name)
    name = name or "default"
    local ok = pcall(function()
        if isfolder and not isfolder("CyrusHub") then
            if makefolder then makefolder("CyrusHub") end
        end
        if writefile then
            writefile("CyrusHub/" .. name .. ".json", HttpService:JSONEncode(self.Flags))
        end
    end)
    return ok
end

function Library:LoadConfig(name)
    name = name or "default"
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("CyrusHub/" .. name .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return false end
    for title, value in pairs(data) do
        local el = self.Elements[title]
        if el and el.Set then
            pcall(function() el:Set(value) end)
        end
    end
    return true
end

