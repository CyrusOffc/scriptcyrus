        Name = "Content",
        Position = UDim2.fromOffset(171, 8),
        Size = UDim2.new(1, -179, 1, -16),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
    }, body)

    self.Content = content

    Corner(content, 12)
    Stroke(content, self.Theme.Stroke, 1, 0.2)

    -- FLOAT BUTTON
    local floatButton = New("TextButton", {
        Name = "FloatButton",
        Size = UDim2.fromOffset(54, 54),
        Position = UDim2.new(1, -74, 1, -74),
        BackgroundColor3 = self.Theme.Primary,
        BorderSizePixel = 0,
        Text = "C",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 21,
        Font = Enum.Font.GothamBlack,
        Visible = false,
        AutoButtonColor = false,
    }, gui)

    self.FloatButton = floatButton

    Corner(floatButton, 27)
    Stroke(floatButton, self.Theme.Gold, 2, 0)

    AddGradient(floatButton, self.Theme.Primary, self.Theme.Gold, 45)

    -- NOTIFICATIONS
    local notificationHolder = New("Frame", {
        Name = "Notifications",
        Size = UDim2.fromOffset(310, 0),
        Position = UDim2.new(1, -325, 0, 15),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, gui)

    self.NotificationHolder = notificationHolder

    New("UIListLayout", {
        Padding = UDim.new(0, 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Top,
    }, notificationHolder)

    -- EVENTS
    local minimized = false

    local function SetMinimized(state)
        minimized = state

        if minimized then
            Tween(
                main,
                TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                {
                    Size = UDim2.fromOffset(0, 0),
                }
            )

            task.delay(0.25, function()
                if main.Parent then
                    main.Visible = false
                    floatButton.Visible = true
                end
            end)
        else
            floatButton.Visible = false
            main.Visible = true

            Tween(
                main,
                TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {
                    Size = mainSize,
                }
            )
        end
    end

    minimize.MouseButton1Click:Connect(function()
        SetMinimized(true)
    end)

    floatButton.MouseButton1Click:Connect(function()
        SetMinimized(false)
    end)

    destroy.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    -- MOBILE RESPONSIVE
    local function UpdateResponsive()
        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local viewport = camera.ViewportSize

        if viewport.X <= 600 then
            main.Size = UDim2.new(1, -18, 1, -70)
            sidebar.Size = UDim2.new(0, 125, 1, -16)
            content.Position = UDim2.fromOffset(141, 8)
            content.Size = UDim2.new(1, -149, 1, -16)
        else
            main.Size = mainSize
            sidebar.Size = UDim2.new(0, 155, 1, -16)
            content.Position = UDim2.fromOffset(171, 8)
            content.Size = UDim2.new(1, -179, 1, -16)
        end
    end

    UpdateResponsive()

    if workspace.CurrentCamera then
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsive)
    end

    return self
end

