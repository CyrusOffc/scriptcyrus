        function section:CreateMultiDropdown(data)
            data = data or {}

            local values = data.Values or data.Options or {}
            local selected = {}

            for _, value in ipairs(data.Default or {}) do
                selected[value] = true
            end

            local row = New("Frame", {
                Size = UDim2.new(1, -14, 0, 54),
