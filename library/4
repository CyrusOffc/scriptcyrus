                BorderSizePixel = 0,
            }, switch)

            Corner(knob, 9)

            local function Update()
                if state then
                    Tween(switch, TweenInfo.new(0.16), {
                        BackgroundColor3 = self.Window.Theme.Primary,
                    })

                    Tween(knob, TweenInfo.new(0.16, Enum.EasingStyle.Back), {
                        Position = UDim2.new(1, -21, 0, 3),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                    })
                else
                    Tween(switch, TweenInfo.new(0.16), {
                        BackgroundColor3 = self.Window.Theme.Surface2,
                    })

                    Tween(knob, TweenInfo.new(0.16), {
                        Position = UDim2.fromOffset(3, 3),
                        BackgroundColor3 = self.Window.Theme.Muted,
                    })
                end

                SafeCallback(data.Callback, state)
            end

            switch.MouseButton1Click:Connect(function()
                state = not state
                Update()
            end)

            function row:Set(value)
                state = value == true
                Update()
            end

            function row:Get()
                return state
            end

            Update()

            table.insert(self.Items, row)
            self:_Add(row)

            return row
        end

        -- SLIDER
        function section:CreateSlider(data)
            data = data or {}

            local min = tonumber(data.Min) or 0
            local max = tonumber(data.Max) or 100
            local value = tonumber(data.Default) or min

            if max <= min then
                max = min + 1
            end

            value = math.clamp(value, min, max)

            local row = New("Frame", {
                Size = UDim2.new(1, -14, 0, 68),
                BackgroundColor3 = self.Window.Theme.Surface,
                BorderSizePixel = 0,
                LayoutOrder = #self.Items + 1,
            })

            Corner(row, 9)
            Stroke(row, self.Window.Theme.Stroke, 1, 0.3)

            New("TextLabel", {
                Position = UDim2.fromOffset(12, 7),
                Size = UDim2.new(1, -80, 0, 18),
                BackgroundTransparency = 1,
                Text = data.Title or "Slider",
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)

            local valueLabel = New("TextLabel", {
                Position = UDim2.new(1, -62, 0, 7),
                Size = UDim2.fromOffset(50, 18),
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = self.Window.Theme.Primary,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Right,
            }, row)

            local bar = New("Frame", {
                Position = UDim2.fromOffset(12, 39),
                Size = UDim2.new(1, -24, 0, 8),
                BackgroundColor3 = self.Window.Theme.Surface2,
                BorderSizePixel = 0,
            }, row)

            Corner(bar, 4)

            local fill = New("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = self.Window.Theme.Primary,
                BorderSizePixel = 0,
            }, bar)

            Corner(fill, 4)

            AddGradient(fill, self.Window.Theme.Primary, self.Window.Theme.Gold, 0)

            local dragging = false

            local function SetValue(newValue)
                value = math.clamp(newValue, min, max)

                local percent = (value - min) / (max - min)

                fill.Size = UDim2.new(percent, 0, 1, 0)
                valueLabel.Text = tostring(math.floor(value * 100) / 100)

                SafeCallback(data.Callback, value)
            end

            local function FromInput(input)
                local percent = math.clamp(
                    (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                    0,
                    1
                )

                SetValue(min + (max - min) * percent)
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = true
                    FromInput(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    FromInput(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            function row:Set(newValue)
                SetValue(tonumber(newValue) or min)
            end

            function row:Get()
                return value
            end

            table.insert(self.Items, row)
            self:_Add(row)

            return row
        end

