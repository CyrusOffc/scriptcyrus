-- NOTIFICATION
--==================================================

function Library:Notify(title, message, duration, icon)
    duration = duration or 3

    if not self.NotificationHolder then
        return
    end

    local theme = self.Theme

    local notification = New("Frame", {
        Size = UDim2.new(1, 0, 0, 76),
        BackgroundColor3 = theme.Surface,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, self.NotificationHolder)

    Corner(notification, 12)
    Stroke(notification, theme.Stroke, 1, 0.15)

    local accent = New("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = theme.Primary,
        BorderSizePixel = 0,
    }, notification)

    Corner(accent, 4)

    local iconLabel = New("TextLabel", {
        Position = UDim2.fromOffset(16, 13),
        Size = UDim2.fromOffset(30, 30),
        BackgroundTransparency = 1,
        Text = icon or "●",
        TextColor3 = theme.Gold,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
    }, notification)

    local titleLabel = New("TextLabel", {
        Position = UDim2.fromOffset(52, 10),
        Size = UDim2.new(1, -64, 0, 22),
        BackgroundTransparency = 1,
        Text = tostring(title or "Notification"),
        TextColor3 = theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, notification)

    local messageLabel = New("TextLabel", {
        Position = UDim2.fromOffset(52, 32),
        Size = UDim2.new(1, -64, 0, 34),
        BackgroundTransparency = 1,
        Text = tostring(message or ""),
        TextColor3 = theme.SubText,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    }, notification)

    notification.BackgroundTransparency = 1
    notification.Size = UDim2.new(1, 0, 0, 0)

    Tween(
        notification,
        TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {
            BackgroundTransparency = 0,
            Size = UDim2.new(1, 0, 0, 76),
        }
    )

    task.delay(duration, function()
        if not notification.Parent then
            return
        end

        local tween = Tween(
            notification,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
            }
        )

        tween.Completed:Wait()

        if notification then
            notification:Destroy()
        end
    end)
end

