                BackgroundTransparency = 1,
                Text = data.Title or "Multi Dropdown",
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)

            local select = New("TextButton", {
                Position = UDim2.new(0.5, -10, 0, 8),
                Size = UDim2.new(0.5, 0, 0, 34),
                BackgroundColor3 = self.Window.Theme.Surface2,
                BorderSizePixel = 0,
                Text = "Select",
                TextColor3 = self.Window.Theme.Text,
                TextSize = 10,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
            }, row)

            Corner(select, 8)

            local optionFrame = New("Frame", {
                Position = UDim2.new(0.5, -10, 0, 46),
                Size = UDim2.new(0.5, 0, 0, 0),
                BackgroundColor3 = self.Window.Theme.Surface,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 20,
                ClipsDescendants = true,
            }, row)

            Corner(optionFrame, 8)
            Stroke(optionFrame, self.Window.Theme.Stroke, 1, 0)

            Padding(optionFrame, 4, 4, 4, 4)

            local layout = New("UIListLayout", {
                Padding = UDim.new(0, 2),
            }, optionFrame)

            local function UpdateText()
                local list = {}

                for _, value in ipairs(values) do
                    if selected[value] then
                        table.insert(list, tostring(value))
                    end
                end

                if #list == 0 then
                    select.Text = "Select"
                elseif #list <= 2 then
                    select.Text = table.concat(list, ", ")
                else
                    select.Text = tostring(#list) .. " selected"
                end

                local output = {}

                for _, value in ipairs(values) do
                    if selected[value] then
                        table.insert(output, value)
                    end
                end

                SafeCallback(data.Callback, output)
            end

            for _, value in ipairs(values) do
                local optionButton = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = self.Window.Theme.Surface,
                    BorderSizePixel = 0,
                    Text = tostring(value),
                    TextColor3 = self.Window.Theme.Text,
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                    ZIndex = 21,
                }, optionFrame)

                Corner(optionButton, 6)

                optionButton.MouseButton1Click:Connect(function()
                    selected[value] = not selected[value]

                    optionButton.BackgroundColor3 = selected[value]
                        and self.Window.Theme.Surface2
                        or self.Window.Theme.Surface

                    UpdateText()
                end)
            end

            select.MouseButton1Click:Connect(function()
                if optionFrame.Visible then
                    optionFrame.Visible = false
                    optionFrame.Size = UDim2.new(0.5, 0, 0, 0)
                else
                    optionFrame.Visible = true
                    optionFrame.Size = UDim2.new(
                        0.5,
                        0,
                        0,
                        math.min(#values, 6) * 30 + 8
                    )
                end
            end)

            function row:Set(list)
                selected = {}

                for _, value in ipairs(list or {}) do
                    selected[value] = true
                end

                UpdateText()
            end

            function row:Get()
                local output = {}

                for _, value in ipairs(values) do
                    if selected[value] then
                        table.insert(output, value)
                    end
                end

                return output
            end

            UpdateText()

            table.insert(self.Items, row)
            self:_Add(row)

            return row
        end

        return section
    end

