    local tab = {
        Window = self,
        Title = config.Title or "Tab",
        Subtitle = config.Subtitle or "",
        Sections = {},
    }

    table.insert(self.Tabs, tab)

    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = #self.Tabs,
    }, self.Sidebar)

    Corner(button, 10)

    local icon = New("ImageLabel", {
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.fromOffset(32, 32),
        BackgroundTransparency = 1,
        Image = config.Icon or "",
        ImageColor3 = self.Theme.SubText,
    }, button)

    local fallbackIcon = New("TextLabel", {
        Position = UDim2.fromOffset(10, 8),
        Size = UDim2.fromOffset(32, 34),
        BackgroundTransparency = 1,
        Text = config.Icon and "" or "●",
        TextColor3 = self.Theme.SubText,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
    }, button)

    local title = New("TextLabel", {
        Position = UDim2.fromOffset(49, 8),
        Size = UDim2.new(1, -56, 0, 19),
        BackgroundTransparency = 1,
        Text = tab.Title,
        TextColor3 = self.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local subtitle = New("TextLabel", {
        Position = UDim2.fromOffset(49, 27),
        Size = UDim2.new(1, -56, 0, 16),
        BackgroundTransparency = 1,
        Text = tab.Subtitle,
        TextColor3 = self.Theme.SubText,
        TextSize = 9,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    tab.Button = button

    local page = New("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.fromOffset(8, 8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Theme.Primary,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, self.Content)

    tab.Page = page

    Padding(page, 4, 4, 4, 4)

    local layout = New("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    local function Select()
        for _, other in ipairs(self.Tabs) do
            other.Page.Visible = false

            Tween(
                other.Button,
                TweenInfo.new(0.18),
                {
                    BackgroundColor3 = self.Theme.Surface,
                }
            )
        end

        page.Visible = true

        Tween(
            button,
            TweenInfo.new(0.18),
            {
                BackgroundColor3 = self.Theme.Surface2,
            }
        )

        self.CurrentTab = tab
    end

    button.MouseButton1Click:Connect(Select)

    if #self.Tabs == 1 then
        Select()
    end

    function tab:CreateSection(titleText)
        local section = {
            Tab = self,
            Window = self.Window,
            Items = {},
        }

        local holder = New("Frame", {
            Size = UDim2.new(1, 0, 0, 44),
            BackgroundColor3 = self.Window.Theme.Surface2,
            BorderSizePixel = 0,
        }, page)

        Corner(holder, 10)
        Stroke(holder, self.Window.Theme.Stroke, 1, 0.2)

        local header = New("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.fromOffset(10, 0),
            BackgroundTransparency = 1,
            Text = tostring(titleText or "Section"),
            TextColor3 = self.Window.Theme.Text,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, holder)

        local listHolder = New("Frame", {
            Position = UDim2.fromOffset(0, 44),
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
        }, holder)

        local list = New("UIListLayout", {
            Padding = UDim.new(0, 7),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, listHolder)

        holder.Size = UDim2.new(1, 0, 0, 44)

        -- The section is made as a container by moving the controls into
        -- a separate frame directly below the title.
        section.Holder = holder
        section.List = listHolder

        table.insert(self.Sections, section)

        -- Reparenting helper is used by controls.
        function section:_Add(control, height)
            control.Parent = listHolder

            local current = listHolder.AbsoluteSize.Y
            holder.Size = UDim2.new(1, 0, 0, 44 + current)

            listHolder.Size = UDim2.new(1, 0, 0, 0)
            listHolder.AutomaticSize = Enum.AutomaticSize.Y
        end

        -- BUTTON
        function section:CreateButton(data)
            data = data or {}

            local row = New("TextButton", {
                Size = UDim2.new(1, -14, 0, 48),
                BackgroundColor3 = self.Window.Theme.Surface,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                LayoutOrder = #self.Items + 1,
            })

            Corner(row, 9)
            Stroke(row, self.Window.Theme.Stroke, 1, 0.3)

            local buttonTitle = New("TextLabel", {
                Position = UDim2.fromOffset(12, 7),
                Size = UDim2.new(1, -24, 0, 18),
                BackgroundTransparency = 1,
                Text = data.Title or "Button",
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)

            local description = New("TextLabel", {
                Position = UDim2.fromOffset(12, 26),
                Size = UDim2.new(1, -24, 0, 15),
                BackgroundTransparency = 1,
                Text = data.Description or "",
                TextColor3 = self.Window.Theme.SubText,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, row)

            row.MouseEnter:Connect(function()
                Tween(row, TweenInfo.new(0.15), {
                    BackgroundColor3 = self.Window.Theme.Surface2,
                })
            end)

            row.MouseLeave:Connect(function()
                Tween(row, TweenInfo.new(0.15), {
