        TabBtn.ZIndex = 5
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 7)

        local IconLbl = Instance.new("ImageLabel", TabBtn)
        IconLbl.Image = icon or "rbxassetid://16932740082"
        IconLbl.BackgroundTransparency = 1
        IconLbl.Position = UDim2.new(0, 14, 0.5, -8)
        IconLbl.Size = UDim2.new(0, 16, 0, 16)
        IconLbl.ImageColor3 = Palette.TextSub
        IconLbl.ZIndex = 6

        local Label = Instance.new("TextLabel", TabBtn)
        Label.Text = name
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 12
        Label.TextColor3 = Palette.TextSub
        Label.BackgroundTransparency = 1
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Position = UDim2.new(0, 40, 0, 0)
        Label.Size = UDim2.new(1, -46, 1, 0)
        Label.ZIndex = 6

        local Content = Instance.new("Frame", ContentScroll)
        Content.BackgroundTransparency = 1
        Content.BorderSizePixel = 0
        Content.Size = UDim2.new(1, 0, 0, 0)
        Content.Visible = false
        Content.ZIndex = 2

        local CLayout = Instance.new("UIListLayout", Content)
        CLayout.Padding = UDim.new(0, 10)
        CLayout.SortOrder = Enum.SortOrder.LayoutOrder
        CLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

        CLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Content.Size = UDim2.new(1, 0, 0, CLayout.AbsoluteContentSize.Y)
            if CurrentTab == name then
                ContentScroll.CanvasSize = UDim2.new(0, 0, 0, CLayout.AbsoluteContentSize.Y + 20)
            end
        end)

        Tabs[name] = {
            Button = TabBtn,
            Label = Label,
            Icon = IconLbl,
            Content = Content,
        }

        TabBtn.Activated:Connect(function()
            SwitchTab(name)
        end)

        -- First tab auto-switch
        if not CurrentTab then
            task.wait(0.05)
            SwitchTab(name)
        end

        -- Return object dengan methods untuk build
        local TabObj = {}
        function TabObj:CreatePanel(title, iconText) return CreatePanel(Content, title, iconText) end
        function TabObj:AddToggle(...) return CreateToggle(...) end
        function TabObj:AddSlider(...) return CreateSlider(...) end
        function TabObj:AddDropdown(...) return CreateDropdown(...) end
        function TabObj:AddButton(...) return CreateButton(...) end
        function TabObj:AddInput(...) return CreateInput(...) end
        function TabObj:Notify(cfg) return Notify(cfg) end
        return TabObj
    end

    function Window:SwitchTab(name) SwitchTab(name) end
    function Window:Notify(cfg) return Notify(cfg) end
    function Window:SetTheme(name) return ConfigSystem:SetTheme(name) end
    function Window:Destroy() ScreenGui:Destroy() end

    -- Config system accessible from outside
    Window.Config = ConfigSystem

    -- Open animation
    Main.Size = UDim2.fromOffset(Size.X.Offset, 0)
    Main.BackgroundTransparency = 0
    TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Size}):Play()

    return Window
end

return CyioxUI
