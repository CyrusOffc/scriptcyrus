    accent.Position = UDim2.new(0, 0, 0, 8)
    Instance.new("UICorner", accent).CornerRadius = UDim.new(0, 3)

    local tLbl = Instance.new("TextLabel", toast)
    tLbl.Text = title
    tLbl.Font = Enum.Font.GothamBold
    tLbl.TextSize = 13
    tLbl.TextColor3 = Palette.TextMain
    tLbl.BackgroundTransparency = 1
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.Position = UDim2.new(0, 14, 0, 8)
    tLbl.Size = UDim2.new(1, -20, 0, 16)

    local cLbl = Instance.new("TextLabel", toast)
    cLbl.Text = content
    cLbl.Font = Enum.Font.Gotham
