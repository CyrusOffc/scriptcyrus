                        local inBG = mk("Frame",{
                            Size=UDim2.new(1,-12,0,22),
                            Position=UDim2.new(0,6,0,name~="" and 20 or 3),
                            BackgroundColor3=T.BG1,
                            ZIndex=17,
                        },inf)
                        rnd(inBG, 5)
