-- ── HELPERS ───────────────────────────────────────────────────
local function tw(obj, props, t, s, d)
    if not obj or not obj.Parent then return end
    local ti = TweenInfo.new(t or T.Spd, s or T.Ease, d or T.Dir)
    TS:Create(obj, ti, props):Play()
end

local function mk(cls, props, par)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do
        pcall(function() i[k] = v end)
    end
    if par then i.Parent = par end
    return i
end

local function rnd(p, r)
    return mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p)
end

local function brdr(p, c, t)
    return mk("UIStroke", {
        Color = c or T.Sky,
        Thickness = t or 1.2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = 0.15,
    }, p)
end

local function shadow(p, size)
    size = size or 18
    return mk("ImageLabel", {
        Name = "Shadow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://5554236805",
        ImageColor3 = Color3.new(0,0,0),
        ImageTransparency = 0.55,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(23,23,277,277),
        Size = UDim2.new(1, size, 1, size),
        Position = UDim2.new(0, -size/2, 0, -size/2),
        ZIndex = (p.ZIndex or 1) - 1,
    }, p)
end

local function grd(p, cs, rot)
    return mk("UIGradient", { Color = cs, Rotation = rot or 90 }, p)
end

local function pad(p, top, bot, left, right)
    return mk("UIPadding", {
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bot or 0),
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
    }, p)
end

local function list(p, gap, fill, halign, valign)
    return mk("UIListLayout", {
        Padding = UDim.new(0, gap or 5),
        FillDirection = fill or Enum.FillDirection.Vertical,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, p)
end

local function G(...)
    local kps, a = {}, {...}
    for i = 1, #a, 2 do
        table.insert(kps, ColorSequenceKeypoint.new(a[i], a[i+1]))
    end
    return ColorSequence.new(kps)
end

local function ripple(parent, zix)
    local rp = mk("Frame", {
        Size = UDim2.new(0, 0, 0, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = T.Sky,
        BackgroundTransparency = 0.65,
        ZIndex = zix or 99,
        ClipsDescendants = false,
        BorderSizePixel = 0,
    }, parent)
    rnd(rp, 999)
    tw(rp, { Size = UDim2.new(2.8, 0, 5.5, 0), BackgroundTransparency = 1 }, 0.45)
    task.delay(0.45, function()
        pcall(function() rp:Destroy() end)
    end)
end

local function ico(parent, icon, size, pos, color, z, anchor)
    return mk("ImageLabel", {
        BackgroundTransparency = 1,
        Size = size or UDim2.new(0, 14, 0, 14),
        Position = pos or UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = anchor or Vector2.new(0, 0.5),
        Image = icon,
        ImageColor3 = color or T.Sky,
        ZIndex = z or 16,
    }, parent)
end

