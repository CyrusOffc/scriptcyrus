-- SEARCH DROPDOWN (FIXED: min width 180, no shrink)
-- ══════════════════════════════════════════════════════════════
local activeDropdown = nil

local function createSearchDropdown(gui, selBox, opts, def, cb, isMulti)
    local dd = { Value = isMulti and {} or def }
    if isMulti then
        for _, v in ipairs(def) do
            dd.Value[v] = true
        end
    end

    local opened = false
    local overlay

    local selTxt = mk("TextLabel", {
        Size = UDim2.new(1, -22, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(def),
        TextSize = 10,
        TextColor3 = T.Text,
        Font = T.FontR,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 62,
    }, selBox)

    local arrow = mk("ImageLabel", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(1, -16, 0.5, -6),
        BackgroundTransparency = 1,
        Image = Icons.chevronDown,
        ImageColor3 = T.Sky,
        ZIndex = 62,
    }, selBox)

    local function updateDisplay()
        if isMulti then
            local cnt, names = 0, {}
            for k, v in pairs(dd.Value) do
                if v then cnt = cnt + 1; table.insert(names, k) end
            end
            if cnt > 0 then
                selTxt.Text = table.concat(names, ", ")
                selTxt.TextColor3 = T.Text
            else
                selTxt.Text = "None selected"
                selTxt.TextColor3 = T.TextSub
            end
        else
            selTxt.Text = tostring(dd.Value)
            selTxt.TextColor3 = T.Text
        end
    end

    local function closeDropdown()
        if not opened then return end
        opened = false
        if activeDropdown == dd then activeDropdown = nil end
        if overlay then
            local ov = overlay
            overlay = nil
            tw(ov, { Size = UDim2.new(0, ov.AbsoluteSize.X, 0, 0) }, 0.16)
            task.delay(0.16, function()
                pcall(function() ov:Destroy() end)
            end)
        end
        tw(arrow, { Rotation = 0 }, 0.16)
    end

    local function buildList()
        if overlay then overlay:Destroy() end

        -- FIX: minimum width 200px biar gak mengecil
        local MIN_W = 200
        local boxW = math.max(selBox.AbsoluteSize.X, MIN_W)
        local maxH = math.min(#opts * 26 + 38, 200)

        -- FIX: cek posisi biar gak keluar layar
        local vp = gui.AbsoluteSize
        local openUp = false
        local spaceBelow = vp.Y - (selBox.AbsolutePosition.Y + selBox.AbsoluteSize.Y)
        if spaceBelow < maxH + 12 then openUp = true end

        local posY = openUp
            and (selBox.AbsolutePosition.Y - maxH - 4)
            or  (selBox.AbsolutePosition.Y + selBox.AbsoluteSize.Y + 4)

        -- FIX: cek posisi X biar gak keluar kanan
        local posX = selBox.AbsolutePosition.X
        if posX + boxW > vp.X - 8 then
            posX = vp.X - boxW - 8
        end
        if posX < 8 then posX = 8 end

        overlay = mk("Frame", {
            Size = UDim2.new(0, boxW, 0, 0),
            Position = UDim2.new(0, posX, 0, posY),
            BackgroundColor3 = T.BG2,
            BorderSizePixel = 0,
            Visible = true,
            ZIndex = 500,
            ClipsDescendants = true,
        }, gui)
        rnd(overlay, 8)
        brdr(overlay, T.Sky, 1.4)
        grd(overlay, G(0, Color3.fromRGB(28, 48, 92), 1, Color3.fromRGB(14, 26, 56)), 140)
        shadow(overlay, 16)

        local searchBG = mk("Frame", {
            Size = UDim2.new(1, -10, 0, 24),
            Position = UDim2.new(0, 5, 0, 5),
            BackgroundColor3 = T.BG1,
            ZIndex = 501,
        }, overlay)
        rnd(searchBG, 6)
        brdr(searchBG, T.BG5, 1)
        ico(searchBG, Icons.search, UDim2.new(0, 11, 0, 11), UDim2.new(0, 7, 0.5, 0), T.Sky, 502)

        local searchBox = mk("TextBox", {
            Size = UDim2.new(1, -28, 1, 0),
            Position = UDim2.new(0, 24, 0, 0),
            BackgroundTransparency = 1,
            Text = "",
            PlaceholderText = "Search...",
            PlaceholderColor3 = T.TextDim,
            TextSize = 10,
            TextColor3 = T.Text,
            Font = T.FontR,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            ZIndex = 502,
        }, searchBG)

        local scroll = mk("ScrollingFrame", {
            Size = UDim2.new(1, -10, 1, -38),
            Position = UDim2.new(0, 5, 0, 34),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = T.Sky,
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 501,
        }, overlay)
        list(scroll, 3)

        local function render(filter)
            for _, ch in pairs(scroll:GetChildren()) do
                if ch:IsA("TextButton") or ch:IsA("Frame") then
                    ch:Destroy()
                end
            end
            for _, opt in ipairs(opts) do
                local matched = (filter == "" or filter == nil)
                    or string.find(string.lower(opt), string.lower(filter), 1, true) ~= nil
                if matched then
                    if isMulti then
                        local sel = dd.Value[opt] == true
                        local oF = mk("Frame", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = sel and T.Sky or T.BG3,
                            ZIndex = 502,
                        }, scroll)
                        rnd(oF, 5)

                        local chk = mk("Frame", {
                            Size = UDim2.new(0, 13, 0, 13),
                            Position = UDim2.new(0, 6, 0.5, -6.5),
                            BackgroundColor3 = sel and Color3.fromRGB(255,255,255) or T.BG5,
                            ZIndex = 503,
                        }, oF)
                        rnd(chk, 4)
                        if sel then
                            ico(chk, Icons.check, UDim2.new(0.65,0,0.65,0), UDim2.new(0.5,0,0.5,0), T.Sky, 504, Vector2.new(0.5,0.5))
                        end

                        mk("TextLabel", {
                            Size = UDim2.new(1,-28,1,0),
                            Position = UDim2.new(0,24,0,0),
                            BackgroundTransparency = 1,
                            Text = opt,
                            TextSize = 10,
                            TextColor3 = sel and Color3.fromRGB(255,255,255) or T.TextSub,
                            Font = sel and T.FontB or T.FontR,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 503,
                        }, oF)

                        local oc = mk("TextButton", {
                            Size = UDim2.new(1,0,1,0),
                            BackgroundTransparency = 1,
                            Text = "",
                            ZIndex = 504,
                            AutoButtonColor = false,
                        }, oF)
                        oc.MouseButton1Click:Connect(function()
                            if dd.Value[opt] then
                                dd.Value[opt] = nil
                            else
                                dd.Value[opt] = true
                            end
                            updateDisplay()
                            cb(dd.Value)
                            render(searchBox.Text)
                        end)
                    else
                        local sel = opt == dd.Value
                        local ob = mk("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = sel and T.Sky or T.BG3,
                            Text = opt,
                            TextSize = 10,
                            TextColor3 = sel and Color3.fromRGB(255,255,255) or T.TextSub,
                            Font = sel and T.FontB or T.FontR,
                            ZIndex = 502,
                            AutoButtonColor = false,
                        }, scroll)
                        rnd(ob, 5)
                        ob.MouseEnter:Connect(function()
                            tw(ob, {BackgroundColor3 = sel and T.SkyBrt or T.BG4, TextColor3 = Color3.fromRGB(255,255,255)}, 0.12)
                        end)
                        ob.MouseLeave:Connect(function()
                            tw(ob, {BackgroundColor3 = sel and T.Sky or T.BG3, TextColor3 = sel and Color3.fromRGB(255,255,255) or T.TextSub}, 0.12)
                        end)
                        ob.MouseButton1Click:Connect(function()
                            dd.Value = opt
                            updateDisplay()
                            cb(opt)
                            closeDropdown()
                        end)
                    end
                end
            end
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            render(searchBox.Text)
        end)

        render("")
        return overlay, boxW, maxH
    end

    local clicker = mk("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 63,
        AutoButtonColor = false,
    }, selBox)

    clicker.MouseButton1Click:Connect(function()
        if opened then
            closeDropdown()
        else
            if activeDropdown and activeDropdown ~= dd then
                activeDropdown.close()
            end
            opened = true
            activeDropdown = dd
            local ov, boxW, maxH = buildList()
            ov.Size = UDim2.new(0, boxW, 0, 0)
            tw(ov, {Size = UDim2.new(0, boxW, 0, maxH)}, 0.24, T.EaseB)
            tw(arrow, {Rotation = 180}, 0.18)
        end
    end)

    UIS.InputBegan:Connect(function(inp)
        if not opened then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            local pos = inp.Position
            local inSel = pos.X >= selBox.AbsolutePosition.X
                and pos.X <= selBox.AbsolutePosition.X + selBox.AbsoluteSize.X
                and pos.Y >= selBox.AbsolutePosition.Y
                and pos.Y <= selBox.AbsolutePosition.Y + selBox.AbsoluteSize.Y
            local inOver = overlay
                and pos.X >= overlay.AbsolutePosition.X
                and pos.X <= overlay.AbsolutePosition.X + overlay.AbsoluteSize.X
                and pos.Y >= overlay.AbsolutePosition.Y
                and pos.Y <= overlay.AbsolutePosition.Y + overlay.AbsoluteSize.Y
            if not inSel and not inOver then
                closeDropdown()
            end
        end
    end)

    function dd:Set(v)
        if isMulti and type(v) == "table" then
            dd.Value = {}
            for _, x in ipairs(v) do dd.Value[x] = true end
        else
            dd.Value = v
        end
        updateDisplay()
        cb(dd.Value)
    end

    function dd:Refresh(o)
        opts = o
    end

    dd.close = closeDropdown

    updateDisplay()
    return dd
end

