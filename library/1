        ValueLbl.ZIndex = 5

        local Track = Instance.new("Frame", Container)
        Track.BackgroundColor3 = Color3.fromRGB(35, 42, 58)
        Track.BorderSizePixel = 0
        Track.Position = UDim2.new(0, 6, 0, 28)
        Track.Size = UDim2.new(1, -12, 0, 5)
        Track.ZIndex = 4
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame", Track)
        Fill.BackgroundColor3 = GetColor()
        Fill.BorderSizePixel = 0
        Fill.Size = UDim2.new(0, 0, 1, 0)
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        table.insert(ConfigSystem.ThemeElements, {Update = function(c) Fill.BackgroundColor3 = c end})

        local Knob = Instance.new("Frame", Track)
        Knob.BackgroundColor3 = Color3.fromRGB(245, 250, 255)
        Knob.BorderSizePixel = 0
        Knob.AnchorPoint = Vector2.new(0.5, 0.5)
        Knob.Position = UDim2.new(0, 0, 0.5, 0)
        Knob.Size = UDim2.new(0, 12, 0, 12)
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local data = { Min = minV or 0, Max = maxV or 100, Value = defV or minV or 0, Dragging = false }

        local function Apply(v, fire)
            v = math.clamp(math.floor(v + 0.5), data.Min, data.Max)
            data.Value = v
            ValueLbl.Text = tostring(v)
            local pct = (v - data.Min) / (data.Max - data.Min)
            Fill.Size = UDim2.new(pct, 0, 1, 0)
            Knob.Position = UDim2.new(pct, 0, 0.5, 0)
            if fire ~= false then SafeCallback(callback, v) end
        end

        Apply(data.Value, false)

        local function UpdateFromInput(input)
            local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            Apply(data.Min + pct * (data.Max - data.Min), true)
        end

        Track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                data.Dragging = true
                UpdateFromInput(inp)
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if data.Dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(inp)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                data.Dragging = false
            end
        end)

        local api = { Value = data.Value, Type = "Slider", Id = elementId }
        function api:Set(v) Apply(v, false) end
        if elementId then AllElements[elementId] = api end
        return api
    end

