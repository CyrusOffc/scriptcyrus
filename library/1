function ConfigSystem:GetColor()
    return self.ThemeColors[self.CurrentTheme] or Palette.Accent
end

function ConfigSystem:SetTheme(name)
    if self.ThemeColors[name] then
        self.CurrentTheme = name
        local c = self:GetColor()
        for _, el in pairs(self.ThemeElements) do
            if type(el) == "table" and type(el.Update) == "function" then
                pcall(el.Update, c)
            end
        end
        return true, c
    end
    return false, nil
end

function ConfigSystem:EnsureFolder()
    if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
end

function ConfigSystem:SaveConfig(name, data)
    self:EnsureFolder()
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({ Name = name, Theme = self.CurrentTheme, Data = data or {}, SavedAt = os.time() })
    end)
    if ok then
        local wok = pcall(function() writefile(ConfigFolder .. "/" .. name .. ".json", encoded) end)
        if wok then
            self.CurrentConfig = name
            return true
        end
    end
    return false
end

function ConfigSystem:LoadConfig(name)
    self:EnsureFolder()
    local path = ConfigFolder .. "/" .. name .. ".json"
    if isfile(path) then
        local ok, content = pcall(function() return readfile(path) end)
        if ok then
            local ok2, config = pcall(function() return HttpService:JSONDecode(content) end)
            if ok2 and config then
                self.CurrentTheme = config.Theme or "Sky"
                return config.Data
            end
        end
    end
    return nil
end

function ConfigSystem:DeleteConfig(name)
    self:EnsureFolder()
    local path = ConfigFolder .. "/" .. name .. ".json"
    if isfile(path) then
        pcall(function() delfile(path) end)
        return true
    end
    return false
end

function ConfigSystem:GetConfigList()
    self:EnsureFolder()
    local list = {}
    local ok, files = pcall(function() return listfiles(ConfigFolder) end)
    if ok and files then
        for _, fp in ipairs(files) do
            local fn = fp:match("([^/\\]+)%.json$")
            if fn then table.insert(list, fn) end
        end
    end
    return list
end

