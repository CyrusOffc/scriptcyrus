        SwitchStroke.Color = Palette.StrokeSoft
        SwitchStroke.Thickness = 1

        local Thumb = Instance.new("Frame", Switch)
        Thumb.BackgroundColor3 = Color3.fromRGB(180, 190, 210)
        Thumb.BorderSizePixel = 0
        Thumb.Position = default and UDim2.new(0, 19, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        Thumb.Size = UDim2.new(0, 14, 0, 14)
        Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

        local state = default or false

        local function Apply(v, fire)
            state = v
            local col = GetColor()
            if v then
                TweenService:Create(Thumb, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 19, 0.5, -7),
                    BackgroundColor3 = col
                }):Play()
                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = col}):Play()
                TweenService:Create(SwitchStroke, TweenInfo.new(0.2), {Color = col, Transparency = 0.6}):Play()
            else
                TweenService:Create(Thumb, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0, 2, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(180, 190, 210)
                }):Play()
                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 48, 65)}):Play()
                TweenService:Create(SwitchStroke, TweenInfo.new(0.2), {Color = Palette.StrokeSoft, Transparency = 0}):Play()
            end
            if fire ~= false then SafeCallback(callback, state) end
        end

        Apply(state, false)

        Switch.Activated:Connect(function()
            Apply(not state, true)
        end)

        local api = { Value = state, Type = "Toggle", Id = elementId }
        function api:Set(v) Apply(v, false) end
        if elementId then AllElements[elementId] = api end
        return api
    end

