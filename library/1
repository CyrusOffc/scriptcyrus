    local duration = cfg.Duration or 4

    local gui = CoreGui:FindFirstChild("CyioxNotify")
    if not gui then
        gui = Instance.new("ScreenGui")
        gui.Name = "CyioxNotify"
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.ResetOnSpawn = false
        gui.Parent = CoreGui
    end

    local toast = Instance.new("Frame", gui)
    toast.BackgroundColor3 = Palette.BgPanel
    toast.BorderSizePixel = 0
    toast.AnchorPoint = Vector2.new(1, 0)
    toast.Position = UDim2.new(1, 20, 0, 20 + (#gui:GetChildren() - 1) * 60)
    toast.Size = UDim2.new(0, 300, 0, 52)
