                    -- ═══════════════════════════════════════
                    -- SLIDER
                    -- ═══════════════════════════════════════
                    function sec:AddSlider(cfg5)
                        cfg5 = cfg5 or {}
                        local name = cfg5.Name or "Slider"
                        local smin = cfg5.Min or 0
                        local smax = cfg5.Max or 100
                        local def  = math.clamp(cfg5.Default or smin, smin, smax)
                        local suf  = cfg5.Suffix or ""
                        local cb   = cfg5.Callback or function() end

                        local sl = { Value = def }

                        local sf = mk("Frame",{Size=UDim2.new(1,0,0,40),BackgroundColor3=T.BG3,ZIndex=16},secCnt)
                        rnd(sf, 6)
                        brdr(sf, T.BG4, 1)

                        mk("TextLabel",{
                            Size=UDim2.new(1,-55,0,16), Position=UDim2.new(0,8,0,4),
                            BackgroundTransparency=1, Text=name,
                            TextSize=9, TextColor3=T.TextSub,
                            Font=T.FontR, TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=17,
                        }, sf)
                        local valLbl = mk("TextLabel",{
                            Size=UDim2.new(0,48,0,16), Position=UDim2.new(1,-55,0,4),
                            BackgroundTransparency=1, Text=tostring(def)..suf,
                            TextSize=9, TextColor3=T.Sky,
                            Font=T.FontB, TextXAlignment=Enum.TextXAlignment.Right,
                            ZIndex=17,
                        }, sf)

                        local track = mk("Frame",{
                            Size=UDim2.new(1,-12,0,4), Position=UDim2.new(0,6,0,26),
                            BackgroundColor3=T.BG5, ZIndex=17,
                        }, sf)
                        rnd(track, 2)

                        local rel = (def-smin)/(smax-smin)
                        local fill = mk("Frame",{Size=UDim2.new(rel,0,1,0),BackgroundColor3=T.Sky,ZIndex=18},track)
                        rnd(fill, 2)
                        grd(fill, G(0,T.Sky, 1,T.SkyBrt))

                        local sk = mk("Frame",{
                            Size=UDim2.new(0,10,0,10),
                            Position=UDim2.new(rel,-5,0.5,-5),
                            BackgroundColor3=Color3.fromRGB(255,255,255),
                            ZIndex=19,
                        }, track)
                        rnd(sk, 5)
                        brdr(sk, T.Sky, 1.5)

                        local sdrag = false
                        local function updateSl(inp)
                            local r = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                            local v = math.floor(smin + (smax - smin) * r)
                            sl.Value = v
                            valLbl.Text = tostring(v)..suf
                            fill.Size = UDim2.new(r,0,1,0)
                            sk.Position = UDim2.new(r,-5,0.5,-5)
                            cb(v)
                        end

                        track.InputBegan:Connect(function(inp)
                            if inp.UserInputType==Enum.UserInputType.MouseButton1
                            or inp.UserInputType==Enum.UserInputType.Touch then
                                sdrag = true; updateSl(inp)
                            end
                        end)
                        UIS.InputChanged:Connect(function(inp)
                            if sdrag and (inp.UserInputType==Enum.UserInputType.MouseMovement
                                       or inp.UserInputType==Enum.UserInputType.Touch) then
                                updateSl(inp)
                            end
                        end)
                        UIS.InputEnded:Connect(function(inp)
                            if inp.UserInputType==Enum.UserInputType.MouseButton1
                            or inp.UserInputType==Enum.UserInputType.Touch then
                                sdrag = false
                            end
                        end)

                        function sl:Set(v)
                            v = math.clamp(v, smin, smax)
                            sl.Value = v
                            local r2 = (v-smin)/(smax-smin)
                            valLbl.Text = tostring(v)..suf
                            tw(fill,{Size=UDim2.new(r2,0,1,0)},0.18)
                            tw(sk,{Position=UDim2.new(r2,-5,0.5,-5)},0.18)
                        end
                        return sl
                    end

