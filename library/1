                            Size=UDim2.new(0,34,0,17),
                            Position=UDim2.new(1,-44,0.5,-8.5),
                            BackgroundColor3 = def and T.Sky or T.BG5,
                            ZIndex=17,
                        }, tf)
                        rnd(swBG, 9)

                        local knob = mk("Frame",{
                            Size=UDim2.new(0,13,0,13),
                            Position=UDim2.new(0, def and 19 or 2, 0.5,-6.5),
                            BackgroundColor3 = Color3.fromRGB(255,255,255),
                            ZIndex=18,
                        }, swBG)
                        rnd(knob, 7)

                        local function updateTog()
                            if tog.Value then
                                tw(swBG, {BackgroundColor3=T.Sky}, 0.2)
                                tw(knob, {Position=UDim2.new(0,19,0.5,-6.5)}, 0.2)
                                toggleIcon.Image = Icons.zap
                                tw(toggleIcon, {ImageColor3 = T.Sky}, 0.2)
                            else
                                tw(swBG, {BackgroundColor3=T.BG5}, 0.2)
                                tw(knob, {Position=UDim2.new(0,2,0.5,-6.5)}, 0.2)
                                toggleIcon.Image = Icons.shield
                                tw(toggleIcon, {ImageColor3 = T.TextDim}, 0.2)
                            end
                        end

                        local cl = mk("TextButton",{
                            Size=UDim2.new(1,0,1,0),
                            BackgroundTransparency=1,
                            Text="",
                            ZIndex=19,
                            AutoButtonColor=false,
                        },tf)

                        cl.MouseButton1Click:Connect(function()
                            tog.Value = not tog.Value
                            updateTog()
                            cb(tog.Value)
                        end)
                        cl.MouseEnter:Connect(function() tw(tf,{BackgroundColor3=T.BG4},0.13) end)
                        cl.MouseLeave:Connect(function() tw(tf,{BackgroundColor3=T.BG3},0.13) end)

                        function tog:Set(v)
                            tog.Value = v
                            updateTog()
                            cb(v)
                        end

                        return tog
                    end

                    -- SLIDER
                    function sec:AddSlider(cfg5)
                        cfg5 = cfg5 or {}
                        local name = cfg5.Name or "Slider"
                        local smin = cfg5.Min or 0
                        local smax = cfg5.Max or 100
                        local def = math.clamp(cfg5.Default or smin, smin, smax)
                        local suf = cfg5.Suffix or ""
                        local cb = cfg5.Callback or function() end
                        local sl = { Value = def }

                        local sf = mk("Frame",{
                            Size=UDim2.new(1,0,0,42),
                            BackgroundColor3=T.BG3,
                            ZIndex=16,
                        },secCnt)
                        rnd(sf, 7)
                        brdr(sf, T.BG4, 1)

                        mk("TextLabel",{
                            Size=UDim2.new(1,-60,0,16),
                            Position=UDim2.new(0,10,0,5),
                            BackgroundTransparency=1,
                            Text=name,
                            TextSize=10,
                            TextColor3=T.TextSub,
                            Font=T.FontR,
                            TextXAlignment=Enum.TextXAlignment.Left,
                            ZIndex=17,
                        }, sf)

                        local valLbl = mk("TextLabel",{
                            Size=UDim2.new(0,52,0,16),
                            Position=UDim2.new(1,-60,0,5),
                            BackgroundTransparency=1,
                            Text=tostring(def)..suf,
                            TextSize=10,
                            TextColor3=T.Sky,
                            Font=T.FontB,
                            TextXAlignment=Enum.TextXAlignment.Right,
                            ZIndex=17,
                        }, sf)

                        local track = mk("Frame",{
                            Size=UDim2.new(1,-14,0,5),
                            Position=UDim2.new(0,7,0,28),
                            BackgroundColor3=T.BG5,
                            ZIndex=17,
                        }, sf)
                        rnd(track, 3)

                        local rel = (def-smin)/(smax-smin)
                        local fill = mk("Frame",{
                            Size=UDim2.new(rel,0,1,0),
                            BackgroundColor3=T.Sky,
                            ZIndex=18,
                        },track)
                        rnd(fill, 3)
                        grd(fill, G(0,T.Sky, 1,T.SkyBrt))

                        local sk = mk("Frame",{
                            Size=UDim2.new(0,12,0,12),
                            Position=UDim2.new(rel,-6,0.5,-6),
                            BackgroundColor3=Color3.fromRGB(255,255,255),
                            ZIndex=19,
                        }, track)
                        rnd(sk, 6)
                        brdr(sk, T.Sky, 1.6)

                        local sdrag = false

                        local function updateSl(inp)
                            local r = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                            local v = math.floor(smin + (smax - smin) * r)
                            sl.Value = v
                            valLbl.Text = tostring(v)..suf
                            fill.Size = UDim2.new(r,0,1,0)
                            sk.Position = UDim2.new(r,-6,0.5,-6)
                            cb(v)
                        end

                        track.InputBegan:Connect(function(inp)
                            if inp.UserInputType==Enum.UserInputType.MouseButton1
                                or inp.UserInputType==Enum.UserInputType.Touch then
                                sdrag = true
                                updateSl(inp)
                            end
                        end)

                        UIS.InputChanged:Connect(function(inp)
                            if sdrag and (inp.UserInputType==Enum.UserInputType.MouseMovement
                                or inp.UserInputType==Enum.UserInputType.Touch) then
                                updateSl(inp)
                            end
                        end)

                        UIS.InputEnded:Connect(function(inp)
                            if inp.UserInputType==Enum.UserInputType.MouseButton1
                                or inp.UserInputType==Enum.UserInputType.Touch then
                                sdrag = false
                            end
                        end)

                        function sl:Set(v)
                            v = math.clamp(v, smin, smax)
                            sl.Value = v
                            local r2 = (v-smin)/(smax-smin)
                            valLbl.Text = tostring(v)..suf
                            tw(fill,{Size=UDim2.new(r2,0,1,0)},0.2)
                            tw(sk,{Position=UDim2.new(r2,-6,0.5,-6)},0.2)
                        end

                        return sl
                    end

