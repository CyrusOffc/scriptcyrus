-- ── HELPERS ───────────────────────────────────────────────────
local function tw(obj, props, t, s, d)
    if not obj or not obj.Parent then return end
    local ti = TweenInfo.new(t or T.Spd, s or T.Ease, d or T.Dir)
    TS:Create(obj, ti, props):Play()
end

local function mk(cls, props, par)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do
        pcall(function() i[k] = v end)
    end
    if par then i.Parent = par end
    return i
end

local function rnd(p, r)
    return mk("UICorner", { CornerRadius = UDim.new(0, r or 6) }, p)
end

local function brdr(p, c, t)
    return mk("UIStroke", {
        Color = c or T.Sky,
        Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
end

local function grd(p, cs, rot)
    return mk("UIGradient", { Color = cs, Rotation = rot or 90 }, p)
end

local function pad(p, top, bot, left, right)
    return mk("UIPadding", {
        PaddingTop    = UDim.new(0, top   or 0),
        PaddingBottom = UDim.new(0, bot   or 0),
        PaddingLeft   = UDim.new(0, left  or 0),
        PaddingRight  = UDim.new(0, right or 0),
    }, p)
end

local function list(p, gap, fill, halign, valign)
    return mk("UIListLayout", {
        Padding             = UDim.new(0, gap   or 4),
        FillDirection       = fill   or Enum.FillDirection.Vertical,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment   = valign or Enum.VerticalAlignment.Top,
        SortOrder           = Enum.SortOrder.LayoutOrder,
    }, p)
end

local function G(...)
    local kps, a = {}, {...}
    for i = 1, #a, 2 do
        table.insert(kps, ColorSequenceKeypoint.new(a[i], a[i+1]))
    end
    return ColorSequence.new(kps)
end

local function ripple(parent, zix)
    local rp = mk("Frame", {
        Size = UDim2.new(0, 0, 0, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = T.Sky,
        BackgroundTransparency = 0.72,
        ZIndex = zix or 99,
        ClipsDescendants = false,
    }, parent)
    rnd(rp, 100)
    tw(rp, { Size = UDim2.new(2.5, 0, 5, 0), BackgroundTransparency = 1 }, 0.42)
    task.delay(0.42, function() pcall(function() rp:Destroy() end) end)
end

local function ico(parent, icon, size, pos, color, z, anchor)
    return mk("ImageLabel", {
        BackgroundTransparency = 1,
        Size = size or UDim2.new(0, 14, 0, 14),
        Position = pos or UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = anchor or Vector2.new(0, 0.5),
        Image = icon,
        ImageColor3 = color or T.Sky,
        ZIndex = z or 16,
    }, parent)
end

-- ── SEARCH DROPDOWN (Overlay with Search) ─────────────────────
local function createSearchDropdown(gui, selBox, opts, def, cb, isMulti)
    local dd = { Value = isMulti and {} or def }
    if isMulti then
        for _, v in ipairs(def) do dd.Value[v] = true end
    end
    local opened = false
    local overlay
    local selTxt = selBox.selTxt

    local arrow = mk("ImageLabel", {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(1, -14, 0.5, -5),
        BackgroundTransparency = 1, Image = Icons.chevron,
        ImageColor3 = T.Sky, ZIndex = 62,
    }, selBox)

    local function updateDisplay()
        if isMulti then
            local cnt, names = 0, {}
            for k, v in pairs(dd.Value) do
                if v then cnt = cnt + 1; table.insert(names, k) end
            end
            if cnt > 0 then
                selTxt.Text = table.concat(names, ", ")
                selTxt.TextColor3 = T.Text
            else
                selTxt.Text = "None selected"
                selTxt.TextColor3 = T.TextSub
            end
        else
            selTxt.Text = dd.Value
        end
    end

    local function buildList()
        if overlay then overlay:Destroy() end
        overlay = mk("Frame", {
            Size = UDim2.new(0, selBox.AbsoluteSize.X, 0, 0),
            Position = UDim2.new(0, selBox.AbsolutePosition.X,
                                 0, selBox.AbsolutePosition.Y + selBox.AbsoluteSize.Y + 3),
            BackgroundColor3 = T.BG2,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 500,
            ClipsDescendants = true,
        }, gui)
        rnd(overlay, 6)
        brdr(overlay, T.Sky, 1.5)
        grd(overlay, G(0, Color3.fromRGB(26, 44, 84), 1, Color3.fromRGB(14, 26, 56)), 135)

        -- Search box
        local searchBG = mk("Frame", {
            Size = UDim2.new(1, -8, 0, 22),
            Position = UDim2.new(0, 4, 0, 4),
            BackgroundColor3 = T.BG1,
            ZIndex = 501,
        }, overlay)
        rnd(searchBG, 4)
        brdr(searchBG, T.BG5, 1)
        ico(searchBG, Icons.search, UDim2.new(0, 10, 0, 10),
            UDim2.new(0, 6, 0.5, 0), T.Sky, 502)
        local searchBox = mk("TextBox", {
            Size = UDim2.new(1, -26, 1, 0), Position = UDim2.new(0, 22, 0, 0),
            BackgroundTransparency = 1, Text = "",
            PlaceholderText = "Search...", PlaceholderColor3 = T.TextDim,
            TextSize = 9, TextColor3 = T.Text, Font = T.FontR,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false, ZIndex = 502,
        }, searchBG)

        -- List scroll
        local scroll = mk("ScrollingFrame", {
            Size = UDim2.new(1, -8, 1, -34),
            Position = UDim2.new(0, 4, 0, 30),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = T.Sky,
            CanvasSize = UDim2.new(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 501,
        }, overlay)
        list(scroll, 2)
        pad(scroll, 0, 0, 0, 0)

        local function render(filter)
            for _, ch in pairs(scroll:GetChildren()) do
                if ch:IsA("TextButton") then ch:Destroy() end
            end
            for _, opt in ipairs(opts) do
                local matched = (filter == "" or filter == nil) or
                    string.find(string.lower(opt), string.lower(filter), 1, true) ~= nil
                if matched then
                    local sel = isMulti and dd.Value[opt] or (opt == dd.Value)
                    local ob
                    if isMulti then
                        ob = mk("Frame", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundColor3 = sel and T.Sky or T.BG3,
                            ZIndex = 502,
                        }, scroll)
                        rnd(ob, 4)
                        local chk = mk("Frame", {
                            Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 5, 0.5, -6),
                            BackgroundColor3 = sel and Color3.fromRGB(255,255,255) or T.BG5,
                            ZIndex = 503,
                        }, ob)
                        rnd(chk, 4)
                        if sel then
                            ico(chk, Icons.check, UDim2.new(0.6,0,0.6,0),
                                UDim2.new(0.5,0,0.5,0), T.Sky, 504, Vector2.new(0.5,0.5))
                        end
                        mk("TextLabel",{
                            Size=UDim2.new(1,-24,1,0), Position=UDim2.new(0,22,0,0),
                            BackgroundTransparency=1, Text=opt,
                            TextSize=9, TextColor3=sel and Color3.fromRGB(255,255,255) or T.TextSub,
                            Font=sel and T.FontB or T.FontR,
                            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=503,
                        }, ob)
                        local clicker = mk("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=504,AutoButtonColor=false},ob)
                        clicker.MouseButton1Click:Connect(function()
                            if dd.Value[opt] then dd.Value[opt] = nil else dd.Value[opt] = true end
                            updateDisplay()
                            cb(dd.Value)
                            render(searchBox.Text)
                        end)
                    else
                        ob = mk("TextButton", {
                            Size = UDim2.new(1, 0, 0, 22),
                            BackgroundColor3 = sel and T.Sky or T.BG3,
                            Text = opt, TextSize = 9,
                            TextColor3 = sel and Color3.fromRGB(255,255,255) or T.TextSub,
                            Font = sel and T.FontB or T.FontR,
                            ZIndex = 502, AutoButtonColor = false,
                        }, scroll)
                        rnd(ob, 4)
                        ob.MouseEnter:Connect(function()
                            tw(ob, {BackgroundColor3 = sel and T.SkyBrt or T.BG4,
                                    TextColor3 = Color3.fromRGB(255,255,255)}, 0.10)
                        end)
                        ob.MouseLeave:Connect(function()
                            tw(ob, {BackgroundColor3 = sel and T.Sky or T.BG3,
                                    TextColor3 = sel and Color3.fromRGB(255,255,255) or T.TextSub}, 0.10)
                        end)
                        ob.MouseButton1Click:Connect(function()
                            dd.Value = opt
                            updateDisplay()
                            cb(opt)
                            opened = false
                            tw(overlay, {Size = UDim2.new(0, selBox.AbsoluteSize.X, 0, 0)}, 0.15)
                            task.delay(0.15, function() overlay.Visible = false end)
                            tw(arrow, {Rotation = 0}, 0.15)
                        end)
                    end
                end
            end
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            render(searchBox.Text)
        end)

        render("")
        return overlay
    end

    local clicker = mk("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "", ZIndex = 63,
        AutoButtonColor = false,
    }, selBox)
    clicker.MouseButton1Click:Connect(function()
        opened = not opened
        if opened then
            local ov = buildList()
            local maxH = math.min(#opts * 24 + 34, 160)
            ov.Visible = true
            ov.Size = UDim2.new(0, selBox.AbsoluteSize.X, 0, 0)
            tw(ov, {Size = UDim2.new(0, selBox.AbsoluteSize.X, 0, maxH)}, 0.22, T.EaseB)
            tw(arrow, {Rotation = 180}, 0.16)
        else
            if overlay then
                tw(overlay, {Size = UDim2.new(0, selBox.AbsoluteSize.X, 0, 0)}, 0.15)
                task.delay(0.15, function()
                    if overlay then overlay.Visible = false end
                end)
            end
            tw(arrow, {Rotation = 0}, 0.15)
        end
    end)

    function dd:Set(v)
        if isMulti then dd.Value = v else dd.Value = v end
        updateDisplay()
        cb(v)
    end
    function dd:Refresh(o) opts = o end

    updateDisplay()
    return dd
end

