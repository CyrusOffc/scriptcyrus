    -- FIX RESIZE: Recalculate ContentArea + Clamp Window
    -- ══════════════════════════════════════════════════════════
    local function recalcLayout()
        if Main.AbsoluteSize.Y <= 40 then return end
        ContentArea.Size = UDim2.new(1, -NavW, 1, -38)
        NavPan.Size = UDim2.new(0, NavW, 1, -38)
        -- Header search visible only if enough width
        if W_WIDTH >= 520 then
            SearchBG.Size = UDim2.new(0, 150, 0, 22)
        else
            SearchBG.Size = UDim2.new(0, 0, 0, 22)
        end
    end

    local function clampWindow()
        task.wait()
        local vp = workspace.CurrentCamera.ViewportSize
        local wp = Main.AbsolutePosition
        local ws = Main.AbsoluteSize

        local newX, newY = wp.X, wp.Y
        if wp.X + ws.X > vp.X then newX = vp.X - ws.X - 10 end
        if wp.Y + ws.Y > vp.Y then newY = vp.Y - ws.Y - 10 end
        if newX < 10 then newX = 10 end
        if newY < 10 then newY = 10 end

        if math.abs(newX - wp.X) > 1 or math.abs(newY - wp.Y) > 1 then
            tw(Main, { Position = UDim2.new(0, newX, 0, newY) }, 0.22)
        end
    end

    Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(recalcLayout)
    Main:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        task.delay(0.05, clampWindow)
    end)
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        task.delay(0.1, clampWindow)
    end)
    MinBtn.MouseButton1Click:Connect(function()
        task.delay(0.35, clampWindow)
    end)
    task.spawn(function()
        task.wait(0.6)
        recalcLayout()
        clampWindow()
    end)
