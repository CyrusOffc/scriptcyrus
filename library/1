    local function SwitchTab(name)
        if not Tabs[name] then return end
        for tName, tData in pairs(Tabs) do
            tData.Content.Visible = false
            TweenService:Create(tData.Button, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            TweenService:Create(tData.Label, TweenInfo.new(0.15), {TextColor3 = Palette.TextSub}):Play()
            if tData.Icon then
                TweenService:Create(tData.Icon, TweenInfo.new(0.15), {ImageColor3 = Palette.TextSub}):Play()
            end
        end
        local t = Tabs[name]
        t.Content.Visible = true
        TweenService:Create(t.Button, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
        TweenService:Create(t.Label, TweenInfo.new(0.15), {TextColor3 = GetColor()}):Play()
        if t.Icon then
            TweenService:Create(t.Icon, TweenInfo.new(0.15), {ImageColor3 = GetColor()}):Play()
        end
        CurrentTabName.Text = name
        CurrentTab = name
    end

    function CyioxUI._SwitchTabInternal(name) SwitchTab(name) end

