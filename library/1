        -- Search
        local SearchBox = Instance.new("TextBox", Popup)
        SearchBox.BackgroundColor3 = Palette.BgInput
        SearchBox.BorderSizePixel = 0
        SearchBox.Position = UDim2.new(0, 6, 0, 6)
        SearchBox.Size = UDim2.new(1, -12, 0, 26)
        SearchBox.Font = Enum.Font.Gotham
        SearchBox.TextSize = 11
        SearchBox.TextColor3 = Palette.TextMain
        SearchBox.PlaceholderText = "🔍 Search..."
        SearchBox.PlaceholderColor3 = Palette.TextDim
        SearchBox.Text = ""
        SearchBox.ClearTextOnFocus = false
        SearchBox.TextXAlignment = Enum.TextXAlignment.Left
        SearchBox.ZIndex = 62
        Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 6)

        local List = Instance.new("ScrollingFrame", Popup)
        List.BackgroundTransparency = 1
        List.BorderSizePixel = 0
        List.Position = UDim2.new(0, 4, 0, 38)
        List.Size = UDim2.new(1, -8, 1, -44)
        List.CanvasSize = UDim2.new(0, 0, 0, 0)
        List.ScrollBarThickness = 2
        List.ScrollBarImageColor3 = Palette.Stroke
        List.ZIndex = 61

        local ListLayout = Instance.new("UIListLayout", List)
        ListLayout.Padding = UDim.new(0, 2)
        ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local dData = {
            All = options or {},
            Filtered = options or {},
            Value = multi and (type(defaultValue) == "table" and defaultValue or {}) or defaultValue,
            Multi = multi,
            Open = false,
        }

        local function UpdateDisplay()
            if dData.Multi then
                if type(dData.Value) == "table" and #dData.Value > 0 then
                    SelLbl.Text = table.concat(dData.Value, ", ")
                    SelLbl.TextColor3 = Palette.TextMain
                else
                    SelLbl.Text = "None selected"
                    SelLbl.TextColor3 = Palette.TextDim
                end
            else
                if dData.Value then
                    SelLbl.Text = tostring(dData.Value)
                    SelLbl.TextColor3 = Palette.TextMain
                else
                    SelLbl.Text = "None selected"
                    SelLbl.TextColor3 = Palette.TextDim
                end
            end
        end

        local optionButtons = {}

        local function RebuildList()
            for _, c in List:GetChildren() do
                if c:IsA("TextButton") then c:Destroy() end
            end
            optionButtons = {}
            local search = string.lower(SearchBox.Text or "")

            for _, opt in ipairs(dData.All) do
                if search == "" or string.find(string.lower(tostring(opt)), search, 1, true) then
                    local Btn = Instance.new("TextButton", List)
                    Btn.BackgroundColor3 = Palette.BgPanelAlt
                    Btn.BackgroundTransparency = 0.4
                    Btn.BorderSizePixel = 0
                    Btn.Size = UDim2.new(1, 0, 0, 26)
                    Btn.Text = "  " .. tostring(opt)
                    Btn.Font = Enum.Font.Gotham
                    Btn.TextSize = 11
                    Btn.TextColor3 = Palette.TextSub
                    Btn.TextXAlignment = Enum.TextXAlignment.Left
                    Btn.AutoButtonColor = false
                    Btn.ZIndex = 63
                    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)

                    local function Refresh()
                        local sel = false
                        if dData.Multi then
                            sel = type(dData.Value) == "table" and table.find(dData.Value, opt) ~= nil
                        else
                            sel = dData.Value == opt
                        end
                        if sel then
                            Btn.BackgroundColor3 = GetColor()
                            Btn.BackgroundTransparency = 0.2
                            Btn.TextColor3 = Palette.BgRoot
                        else
                            Btn.BackgroundColor3 = Palette.BgPanelAlt
                            Btn.BackgroundTransparency = 0.4
                            Btn.TextColor3 = Palette.TextSub
                        end
                    end

                    Btn.Activated:Connect(function()
                        if dData.Multi then
                            if type(dData.Value) ~= "table" then dData.Value = {} end
                            local idx = table.find(dData.Value, opt)
                            if idx then table.remove(dData.Value, idx) else table.insert(dData.Value, opt) end
                        else
                            dData.Value = opt
                        end
                        for _, b in ipairs(optionButtons) do b.Refresh() end
                        UpdateDisplay()
                        SafeCallback(callback, dData.Value)
                        if not dData.Multi then
                            task.wait(0.1)
                            Popup.Visible = false
                            dData.Open = false
                            TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                        end
                    end)

                    Btn.MouseEnter:Connect(function()
                        if Btn.BackgroundTransparency > 0.1 then
                            TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundTransparency = 0.1}):Play()
                        end
                    end)
                    Btn.MouseLeave:Connect(function() Refresh() end)

                    Refresh()
                    table.insert(optionButtons, { Btn = Btn, Refresh = Refresh })
                end
            end
            List.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 4)
        end

        RebuildList()
        UpdateDisplay()

        SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
            RebuildList()
        end)

        local function TogglePopup()
            dData.Open = not dData.Open
            if dData.Open then
                local ap = SelBtn.AbsolutePosition
                local as = SelBtn.AbsoluteSize
                local totalH = math.min(ListLayout.AbsoluteContentSize.Y + 50, 180)
                Popup.Size = UDim2.new(0, 200, 0, 0)
                Popup.Position = UDim2.new(0, ap.X + as.X - 200, 0, ap.Y + as.Y + 4)
                Popup.Visible = true
                TweenService:Create(Popup, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 200, 0, totalH)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 180}):Play()
                TweenService:Create(SelStroke, TweenInfo.new(0.15), {Color = GetColor()}):Play()
            else
                TweenService:Create(Popup, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 200, 0, 0)}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                TweenService:Create(SelStroke, TweenInfo.new(0.15), {Color = Palette.StrokeSoft}):Play()
                task.wait(0.16)
                Popup.Visible = false
                SearchBox.Text = ""
            end
        end

        SelBtn.Activated:Connect(TogglePopup)

        local outConn = UserInputService.InputBegan:Connect(function(inp)
            if dData.Open and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
                local mp = inp.Position
                local pp = Popup.AbsolutePosition
                local ps = Popup.AbsoluteSize
                local sp = SelBtn.AbsolutePosition
                local ss = SelBtn.AbsoluteSize
                if not (mp.X >= pp.X and mp.X <= pp.X + ps.X and mp.Y >= pp.Y and mp.Y <= pp.Y + ps.Y) and
                   not (mp.X >= sp.X and mp.X <= sp.X + ss.X and mp.Y >= sp.Y and mp.Y <= sp.Y + ss.Y) then
                    TogglePopup()
                end
            end
        end)

        Container.Destroying:Connect(function()
            if outConn then outConn:Disconnect() end
            if Popup and Popup.Parent then Popup:Destroy() end
        end)

        local api = { Value = dData.Value, Type = "Dropdown", Id = elementId }
        function api:Set(v)
            dData.Value = v
            for _, b in ipairs(optionButtons) do b.Refresh() end
            UpdateDisplay()
        end
        function api:Refresh(newOpts, newVal)
            dData.All = newOpts or dData.All
            dData.Value = newVal or (dData.Multi and {} or nil)
            RebuildList()
            UpdateDisplay()
        end
        if elementId then AllElements[elementId] = api end
        return api
    end

