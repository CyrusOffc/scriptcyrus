function Library:CreateWindow(config)
    assert(config.Title, "Window - Missing Title")
    if Library.Window then
        print("Only one window allowed")
        return
    end

    Library.UseAcrylic = config.Acrylic or false
    Library.Acrylic = config.Acrylic or false
    Library.Theme = config.Theme or "CyrusPurple"

    local Window = Components.Window({
        Parent = GUI,
        Size = config.Size or UDim2.fromOffset(600, 450),
        Title = config.Title,
        SubTitle = config.SubTitle or "CyrusUI",
        TabWidth = config.TabWidth or 140,
    })

    Library.Window = Window
    Library:SetTheme(Library.Theme)

    -- Toast notification welcome
    task.delay(1, function()
        Library:Notify({
            Title = "<font color='#b42cff'>✦ CyrusUI</font>",
            Content = "Interface loaded successfully!",
            SubContent = "Join: discord.gg/speedhubx",
            Duration = 8,
        })
    end)

    return Window
end

function Library:SetTheme(value)
    if Library.Window and table.find(Library.Themes, value) then
        Library.Theme = value
        Creator.UpdateTheme()
    end
end

function Library:Destroy()
    if Library.Window then
        Library.Unloaded = true
        Creator.Disconnect()
        Library.GUI:Destroy()
    end
end

function Library:ToggleAcrylic(value)
    -- Simplified
end

function Library:ToggleTransparency(value)
    if Library.Window then
        Library.Window.AcrylicPaint.Frame.Background.BackgroundTransparency = value and 0.35 or 0
    end
end

function Library:Notify(config)
    return NotificationModule:New(config)
end

if getgenv then
    getgenv().CyrusUI = Library
else
    _G.CyrusUI = Library
end

return Library, SaveManager, InterfaceManager
