-- ═══════════════ SPRING ENGINE ═══════════════
local Spring = {}
Spring.__index = Spring

function Spring.new(value, opts)
    opts = opts or {}
    return setmetatable({
        Value = value, Target = value, Velocity = 0,
        Freq = opts.frequency or 6, Damp = opts.damping or 1,
    }, Spring)
end

function Spring:Update(dt)
    local freq = self.Freq * 2 * math.pi
    local d = self.Damp
    local offset = self.Value - self.Target
    local decay = math.exp(-d * freq * dt)

    if d >= 1 then
        self.Value = (offset * (1 + freq * dt) + self.Velocity * dt) * decay + self.Target
        self.Velocity = (self.Velocity * (1 - freq * dt) - offset * (freq * freq * dt)) * decay
    else
        local c = math.sqrt(1 - d * d)
        local i = math.cos(freq * c * dt)
        local j = math.sin(freq * c * dt)
        local z = j / c
        local y = j / (freq * c)
        self.Value = (offset * (i + d * z) + self.Velocity * y) * decay + self.Target
        self.Velocity = (self.Velocity * (i - z * d) - offset * (z * freq)) * decay
    end

    if math.abs(self.Velocity) < 0.001 and math.abs(self.Value - self.Target) < 0.001 then
        self.Value = self.Target
        self.Velocity = 0
        return true
    end
    return false
end

-- ═══════════════ CREATOR HELPERS ═══════════════
local Creator = { Connections = {} }

function Creator.Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Creator.Connections, c)
    return c
end

function Creator.Cleanup()
    for i = #Creator.Connections, 1, -1 do
        pcall(function() Creator.Connections[i]:Disconnect() end)
        Creator.Connections[i] = nil
    end
end

function Creator.New(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = obj end
    return obj
end

function Creator.Corner(parent, radius)
    return Creator.New("UICorner", {CornerRadius = UDim.new(0, radius or 8), Parent = parent})
end

function Creator.Stroke(parent, color, thickness, transparency)
    return Creator.New("UIStroke", {
        Color = color or Color3.new(1,1,1),
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

function Creator.Gradient(parent, c1, c2, rotation)
    return Creator.New("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rotation or 90,
        Parent = parent,
    })
end

function Creator.Padding(parent, t, r, b, l)
    return Creator.New("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        Parent = parent,
    })
end

