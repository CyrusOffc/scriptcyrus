-- ============================================================
-- FLIPPER (Smooth Spring Animation Engine)
-- ============================================================
local Flipper = {}

local VELOCITY_THRESHOLD = 0.001
local POSITION_THRESHOLD = 0.001
local EPS = 0.0001

function Flipper.Spring(targetValue, options)
    options = options or {}
    return {
        _type = "Spring",
        _targetValue = targetValue,
        _frequency = options.frequency or 4,
        _dampingRatio = options.dampingRatio or 1,
    }
end

function Flipper.Instant(targetValue)
    return { _type = "Instant", _targetValue = targetValue }
end

function Flipper.Linear(targetValue, options)
    options = options or {}
    return { _type = "Linear", _targetValue = targetValue, _velocity = options.velocity or 1 }
end

function Flipper.step(goal, state, dt)
    if goal._type == "Instant" then
        return { complete = true, value = goal._targetValue, velocity = 0 }
    end

    local d = goal._dampingRatio
    local f = goal._frequency * 2 * math.pi
    local g = goal._targetValue
    local p0 = state.value
    local v0 = state.velocity or 0

    local offset = p0 - g
    local decay = math.exp(-d * f * dt)

    local p1, v1

    if d == 1 then
        p1 = (offset * (1 + f * dt) + v0 * dt) * decay + g
        v1 = (v0 * (1 - f * dt) - offset * (f * f * dt)) * decay
    elseif d < 1 then
        local c = math.sqrt(1 - d * d)
        local i = math.cos(f * c * dt)
        local j = math.sin(f * c * dt)

        local z
        if c > EPS then
            z = j / c
        else
            local a = dt * f
            z = a + ((a * a) * (c * c) * (c * c) / 20 - c * c) * (a * a * a) / 6
        end

        local y
        if f * c > EPS then
            y = j / (f * c)
        else
            local b = f * c
            y = dt + ((dt * dt) * (b * b) * (b * b) / 20 - b * b) * (dt * dt * dt) / 6
        end

        p1 = (offset * (i + d * z) + v0 * y) * decay + g
        v1 = (v0 * (i - z * d) - offset * (z * f)) * decay
    else
        local c = math.sqrt(d * d - 1)
        local r1 = -f * (d - c)
        local r2 = -f * (d + c)
        local co2 = (v0 - offset * r1) / (2 * f * c)
        local co1 = offset - co2
        local e1 = co1 * math.exp(r1 * dt)
        local e2 = co2 * math.exp(r2 * dt)
        p1 = e1 + e2 + g
        v1 = e1 * r1 + e2 * r2
    end

    local complete = math.abs(v1) < VELOCITY_THRESHOLD and math.abs(p1 - g) < POSITION_THRESHOLD
    return { complete = complete, value = complete and g or p1, velocity = v1 }
end

-- Signal system
local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({ _connections = {}, _threads = {} }, Signal)
end

function Signal:fire(...)
    for _, conn in pairs(self._connections) do
        if conn.connected then conn._handler(...) end
    end
    for _, thread in pairs(self._threads) do
        coroutine.resume(thread, ...)
    end
    self._threads = {}
end

function Signal:connect(handler)
    local conn = { signal = self, connected = true, _handler = handler }
    table.insert(self._connections, conn)
    return {
        disconnect = function()
            conn.connected = false
            for i, c in pairs(self._connections) do
                if c == conn then table.remove(self._connections, i) return end
            end
        end
    }
end

-- Motors
local Motor = {}
Motor.__index = Motor

function Motor.new(initial, useImplicitConnections)
    return setmetatable({
        _state = { value = initial, velocity = 0, complete = true },
        _goal = nil,
        _connection = nil,
        _onStep = Signal.new(),
        _onComplete = Signal.new(),
        _useImplicitConnections = useImplicitConnections ~= false,
    }, Motor)
end

function Motor:onStep(fn) return self._onStep:connect(fn) end
function Motor:onComplete(fn) return self._onComplete:connect(fn) end
function Motor:getValue() return self._state.value end

function Motor:setGoal(goal)
    self._state.complete = false
    self._goal = goal
    if self._useImplicitConnections and not self._connection then
        self._connection = RunService.RenderStepped:Connect(function(dt)
            self:step(dt)
        end)
    end
end

function Motor:step(dt)
    if self._state.complete or not self._goal then return true end
    local new = Flipper.step(self._goal, self._state, dt)
    self._state = new
    self._onStep:fire(new.value)
    if new.complete then
        if self._useImplicitConnections and self._connection then
            self._connection:Disconnect()
            self._connection = nil
        end
        self._onComplete:fire()
    end
    return new.complete
end

function Motor:stop()
    if self._connection then self._connection:Disconnect() self._connection = nil end
end

