        AutoButtonColor = false,
        Parent = frame,
    })
    Creator.Corner(keyBtn, 8)
    Creator.Stroke(keyBtn, CurrentTheme.Border, 1, 0.5)

    local KeybindObj = {Value = value, Mode = mode, Toggled = false}
    KeybindObj.Callback = cfg.Callback
    KeybindObj.Changed = nil
    local picking = false

    keyBtn.MouseButton1Click:Connect(function()
        picking = true
        keyBtn.Text = "..."
        Animator.Tween(stroke, {Color = CurrentTheme.Accent}, 0.2)
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if picking then
            local k
            if input.UserInputType == Enum.UserInputType.Keyboard then
                k = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then k = "MouseLeft"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then k = "MouseRight" end
            if k then
                picking = false
                keyBtn.Text = k
                KeybindObj.Value = k
                Animator.Tween(stroke, {Color = CurrentTheme.Border}, 0.2)
                if KeybindObj.Changed then task.spawn(function() pcall(KeybindObj.Changed, k) end) end
            end
        else
            local k
            if input.UserInputType == Enum.UserInputType.Keyboard then k = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then k = "MouseLeft"
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then k = "MouseRight" end
            if k and k == KeybindObj.Value and mode == "Toggle" then
                KeybindObj.Toggled = not KeybindObj.Toggled
                if KeybindObj.Callback then task.spawn(function() pcall(KeybindObj.Callback, KeybindObj.Toggled) end) end
            end
        end
    end)

    KeybindObj.SetValue = function(v, m)
        value = v or value
        mode = m or mode
        keyBtn.Text = value
        KeybindObj.Value = value
        KeybindObj.Mode = mode
    end
    KeybindObj.GetValue = function() return KeybindObj.Value end
    KeybindObj.OnChanged = function(fn) KeybindObj.Changed = fn fn(KeybindObj.Value) end
    KeybindObj.OnClick = function(fn) KeybindObj.Callback = fn end

    return KeybindObj
end

