                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 16,
                }, SliderFrame)
                
                -- Track
                local Track = CreateInstance("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 34),
                    BackgroundColor3 = Theme.SliderBG,
                    BorderSizePixel = 0,
                    ZIndex = 16,
                }, SliderFrame)
                AddCorner(Track, 3)
                AddStroke(Track, Theme.BorderDim, 1)
                
                -- Fill
                local Fill = CreateInstance("Frame", {
                    Size = UDim2.new((SliderDefault - SliderMin) / (SliderMax - SliderMin), 0, 1, 0),
                    BackgroundColor3 = Theme.Gold,
                    BorderSizePixel = 0,
                    ZIndex = 17,
                }, Track)
                AddCorner(Fill, 3)
                
                local fillGrad = CreateInstance("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(212, 175, 55)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 215, 80)),
                    }),
                    Rotation = 0,
                }, Fill)
                
                -- Knob
                local SliderKnob = CreateInstance("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new((SliderDefault - SliderMin) / (SliderMax - SliderMin), -7, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    ZIndex = 18,
                }, Track)
                AddCorner(SliderKnob, 7)
                AddStroke(SliderKnob, Theme.Gold, 1.5)
                
                -- Slider Logic
                local sliderDragging = false
                
                local function UpdateSlider(input)
                    local trackPos = Track.AbsolutePosition.X
                    local trackSize = Track.AbsoluteSize.X
                    local relative = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
                    local value = math.floor(SliderMin + (SliderMax - SliderMin) * relative)
                    
                    Slider.Value = value
                    SliderValue.Text = tostring(value) .. SliderSuffix
                    
                    Tween(Fill, {Size = UDim2.new(relative, 0, 1, 0)}, 0.05)
                    Tween(SliderKnob, {Position = UDim2.new(relative, -7, 0.5, -7)}, 0.05)
                    
                    SliderCallback(value)
                end
                
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or
                       input.UserInputType == Enum.UserInputType.Touch then
                        sliderDragging = true
                        UpdateSlider(input)
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
                                          input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSlider(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or
                       input.UserInputType == Enum.UserInputType.Touch then
                        sliderDragging = false
                    end
                end)
                
                -- Hover effects
                SliderFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        Tween(SliderKnob, {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(
                            (Slider.Value - SliderMin)/(SliderMax - SliderMin), -9, 0.5, -9
                        )}, 0.1)
                    end
                end)
                SliderFrame.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        Tween(SliderKnob, {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(
                            (Slider.Value - SliderMin)/(SliderMax - SliderMin), -7, 0.5, -7
                        )}, 0.1)
                    end
                end)
                
                function Slider:Set(val)
                    val = math.clamp(val, SliderMin, SliderMax)
                    Slider.Value = val
                    SliderValue.Text = tostring(val) .. SliderSuffix
                    local rel = (val - SliderMin) / (SliderMax - SliderMin)
                    Tween(Fill, {Size = UDim2.new(rel, 0, 1, 0)}, 0.2)
                    Tween(SliderKnob, {Position = UDim2.new(rel, -7, 0.5, -7)}, 0.2)
                    SliderCallback(val)
                end
                
                return Slider
            end
            
