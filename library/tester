            NewNotif.Holder.Size = UDim2.new(1, 0, 0, 58 + contentSize)
            rootMotor:setGoal(Flipper.Spring(0, { frequency = 5 }))
            offsetMotor:setGoal(Flipper.Spring(0, { frequency = 5 }))
        end

        function NewNotif:Close()
            if not NewNotif.Closed then
                NewNotif.Closed = true
                task.spawn(function()
                    rootMotor:setGoal(Flipper.Spring(1, { frequency = 5 }))
                    offsetMotor:setGoal(Flipper.Spring(60, { frequency = 5 }))
                    task.wait(0.4)
                    if Library.UseAcrylic and acrylicPaint.Model then
                        pcall(function() acrylicPaint.Model:Destroy() end)
                    end
                    NewNotif.Holder:Destroy()
                end)
            end
        end

        NewNotif:Open()
        if config.Duration then
            task.delay(config.Duration, function() NewNotif:Close() end)
        end
        return NewNotif
    end

    return Notification
end)()

