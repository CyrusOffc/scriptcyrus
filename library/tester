-- ═══════════════ ANIMATION HELPER ═══════════════
local Animator = {}
local ActiveSprings = {}

function Animator.Spring(instance, prop, target, freq, damp, callback)
    local current = instance[prop]
    local isUDim2 = typeof(current) == "UDim2"
    local isColor = typeof(current) == "Color3"

    local spring
    if isUDim2 then
        local springX = Spring.new(current.X.Offset, {frequency = freq or 6, damping = damp or 1})
        local springY = Spring.new(current.Y.Offset, {frequency = freq or 6, damping = damp or 1})
        local springXScale = Spring.new(current.X.Scale, {frequency = freq or 6, damping = damp or 1})
        local springYScale = Spring.new(current.Y.Scale, {frequency = freq or 6, damping = damp or 1})
        springX:SetTarget(target.X.Offset)
        springY:SetTarget(target.Y.Offset)
        springXScale:SetTarget(target.X.Scale)
        springYScale:SetTarget(target.Y.Scale)

        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            local done1 = springX:Update(dt)
            local done2 = springY:Update(dt)
            local done3 = springXScale:Update(dt)
            local done4 = springYScale:Update(dt)
            pcall(function()
                instance[prop] = UDim2.new(springXScale.Value, springX.Value, springYScale.Value, springY.Value)
            end)
            if done1 and done2 and done3 and done4 then
                conn:Disconnect()
                if callback then callback() end
            end
        end)
        table.insert(ActiveSprings, conn)
    else
        spring = Spring.new(current, {frequency = freq or 6, damping = damp or 1})
        spring:SetTarget(target)
        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            local done = spring:Update(dt)
            pcall(function() instance[prop] = spring.Value end)
            if done then
                conn:Disconnect()
                if callback then callback() end
            end
        end)
        table.insert(ActiveSprings, conn)
    end
end

function Animator.Tween(instance, props, time, style, dir)
    local tween = TweenService:Create(instance, TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Quint,
        dir or Enum.EasingDirection.Out
    ), props)
    tween:Play()
    return tween
end

-- ═══════════════ RICH TEXT HELPERS ═══════════════
local RichText = {}

function RichText.Gradient(text, colors, speed)
    -- Static gradient (Roblox text supports rich text tags)
    return string.format('<font color="rgb(%d,%d,%d)">%s</font>',
        colors.R * 255, colors.G * 255, colors.B * 255, text)
end

function RichText.Pulse(text, c1, c2)
    local t = (math.sin(tick() * 3) + 1) / 2
    local r = math.floor((c1.R + (c2.R - c1.R) * t) * 255)
    local g = math.floor((c1.G + (c2.G - c1.G) * t) * 255)
    local b = math.floor((c1.B + (c2.B - c1.B) * t) * 255)
    return string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, text)
end

function RichText.Bold(text) return "<b>" .. text .. "</b>" end
function RichText.Italic(text) return "<i>" .. text .. "</i>" end

