        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = CurrentTheme.BgSecondary,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = frame,
    })
    Creator.Corner(display, 8)
    Creator.Stroke(display, CurrentTheme.Border, 1, 0.5)

    local displayLbl = Creator.New("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = "--",
        TextColor3 = CurrentTheme.Text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = display,
    })

    local arrow = Creator.New("TextLabel", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(1, -22, 0, 0),
        BackgroundTransparency = 1,
        Text = "▼",
        TextColor3 = CurrentTheme.Accent,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        Parent = display,
    })

    -- ── POPUP: attached to PopupLayer, not to frame ──
    local popup = Creator.New("Frame", {
        Size = UDim2.new(0, 200, 0, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = CurrentTheme.BgSecondary,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 501,
        Parent = PopupLayer,
    })
    Creator.Corner(popup, 12)
    Creator.Stroke(popup, CurrentTheme.Accent, 1.5, 0.3)
    Creator.Gradient(popup, CurrentTheme.BgSecondary, CurrentTheme.BgMain, 90)

    -- Search box
    local searchBox = Creator.New("TextBox", {
        Size = UDim2.new(1, -12, 0, 30),
        Position = UDim2.new(0, 6, 0, 6),
        BackgroundColor3 = CurrentTheme.BgElement,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "🔍  Search...",
        PlaceholderColor3 = CurrentTheme.SubText,
        TextColor3 = CurrentTheme.Text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        ZIndex = 502,
        Parent = popup,
    })
    Creator.Corner(searchBox, 8)
    local searchStroke = Creator.Stroke(searchBox, CurrentTheme.Border, 1, 0.5)
    Creator.Padding(searchBox, 0, 0, 0, 10)

    local scroll = Creator.New("ScrollingFrame", {
        Size = UDim2.new(1, -12, 1, -46),
        Position = UDim2.new(0, 6, 0, 40),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = CurrentTheme.Accent,
        ScrollBarImageTransparency = 0.5,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 502,
        Parent = popup,
    })
    Creator.New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 3),
        Parent = scroll,
    })

    local opened = false
    local optionButtons = {}

    local DropdownObj = {Value = value, Multi = multi, Values = values}
    DropdownObj.Callback = cfg.Callback
    DropdownObj.Changed = nil

    local function isSelected(v)
        if multi then
            return DropdownObj.Value[v] == true
        else
            return DropdownObj.Value == v
        end
    end

    local function refreshDisplay()
        if multi then
            local arr = {}
            for v, b in pairs(DropdownObj.Value) do
                if b then table.insert(arr, v) end
            end
            displayLbl.Text = #arr > 0 and table.concat(arr, ", ") or "--"
        else
            displayLbl.Text = DropdownObj.Value or "--"
        end
    end

    local function rebuildOptions(filter)
        for _, b in ipairs(optionButtons) do
            pcall(function() b:Destroy() end)
        end
        optionButtons = {}

        filter = (filter or ""):lower()
        local count = 0

        for _, v in ipairs(values) do
            if filter == "" or tostring(v):lower():find(filter, 1, true) then
                count = count + 1
                local sel = isSelected(v)

                local optBtn = Creator.New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = sel and CurrentTheme.Accent or CurrentTheme.BgElement,
                    BackgroundTransparency = sel and 0.4 or 1,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 503,
                    Parent = scroll,
                })
                Creator.Corner(optBtn, 7)

                local check = Creator.New("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(0, 4, 0, 0),
                    BackgroundTransparency = 1,
                    Text = sel and "✓" or "",
                    TextColor3 = CurrentTheme.Accent,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    Parent = optBtn,
                })

                Creator.New("TextLabel", {
                    Size = UDim2.new(1, -28, 1, 0),
                    Position = UDim2.new(0, 24, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(v),
                    TextColor3 = sel and CurrentTheme.Accent or CurrentTheme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Parent = optBtn,
                })

                optBtn.MouseEnter:Connect(function()
                    if not isSelected(v) then
                        Animator.Tween(optBtn, {BackgroundTransparency = 0.5, BackgroundColor3 = CurrentTheme.BgHover}, 0.15)
                    end
                end)
                optBtn.MouseLeave:Connect(function()
                    if not isSelected(v) then
                        Animator.Tween(optBtn, {BackgroundTransparency = 1}, 0.15)
                    end
                end)

                optBtn.MouseButton1Click:Connect(function()
                    if multi then
                        DropdownObj.Value[v] = not DropdownObj.Value[v] or nil
                    else
                        DropdownObj.Value = v
                    end
                    refreshDisplay()
                    rebuildOptions(searchBox.Text)
                    if DropdownObj.Callback then task.spawn(function() pcall(DropdownObj.Callback, DropdownObj.Value) end) end
                    if DropdownObj.Changed then task.spawn(function() pcall(DropdownObj.Changed, DropdownObj.Value) end) end
                    if not multi then DropdownObj.Close() end
                end)

                table.insert(optionButtons, optBtn)
            end
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, count * 33 + 4)
    end

    -- Position popup right below display using world coordinates
    local function positionPopup()
        local pos = display.AbsolutePosition
        local size = display.AbsoluteSize
        popup.Position = UDim2.new(0, pos.X + size.X - 200, 0, pos.Y + size.Y + 4)
    end

    local function open()
        opened = true
        popup.Visible = true
        searchBox.Text = ""
        rebuildOptions("")
        positionPopup()
        local targetH = math.min(#values * 33 + 46, 260)
        Animator.Tween(popup, {Size = UDim2.new(0, 200, 0, targetH)}, 0.25, Enum.EasingStyle.Quint)
        Animator.Tween(arrow, {Rotation = 180}, 0.25)
        Animator.Tween(stroke, {Color = CurrentTheme.BorderAccent}, 0.2)
    end

    local function close()
        opened = false
        Animator.Tween(popup, {Size = UDim2.new(0, 200, 0, 0)}, 0.25, Enum.EasingStyle.Quint)
        Animator.Tween(arrow, {Rotation = 0}, 0.25)
        Animator.Tween(stroke, {Color = CurrentTheme.Border}, 0.2)
        task.delay(0.25, function()
            if not opened then popup.Visible = false end
        end)
    end

    DropdownObj.Open = open
    DropdownObj.Close = close
    DropdownObj.SetValue = function(v)
        if multi then
            DropdownObj.Value = type(v) == "table" and v or {}
        else
            DropdownObj.Value = v
        end
        refreshDisplay()
        if opened then rebuildOptions(searchBox.Text) end
        if DropdownObj.Callback then task.spawn(function() pcall(DropdownObj.Callback, DropdownObj.Value) end) end
    end
    DropdownObj.GetValue = function() return DropdownObj.Value end
    DropdownObj.SetValues = function(vals)
        values = vals
        DropdownObj.Values = vals
        if opened then rebuildOptions(searchBox.Text) end
    end
    DropdownObj.OnChanged = function(fn) DropdownObj.Changed = fn fn(DropdownObj.Value) end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        rebuildOptions(searchBox.Text)
        positionPopup()
    end)

    searchBox.Focused:Connect(function()
        Animator.Tween(searchStroke, {Color = CurrentTheme.Accent}, 0.2)
    end)
    searchBox.FocusLost:Connect(function()
        Animator.Tween(searchStroke, {Color = CurrentTheme.Border}, 0.2)
    end)

    display.MouseButton1Click:Connect(function()
        if opened then close() else open() end
    end)

    -- Close on outside click
    Creator.Connect(UserInputService.InputBegan, function(input)
        if not opened then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mouse = UserInputService:GetMouseLocation()
        local p = popup.AbsolutePosition
        local s = popup.AbsoluteSize
        local dp = display.AbsolutePosition
        local ds = display.AbsoluteSize
        local inPopup = mouse.X >= p.X and mouse.X <= p.X + s.X and mouse.Y >= p.Y and mouse.Y <= p.Y + s.Y
        local inDisplay = mouse.X >= dp.X and mouse.X <= dp.X + ds.X and mouse.Y >= dp.Y and mouse.Y <= dp.Y + ds.Y
        if not inPopup and not inDisplay then close() end
    end)

    -- Reposition popup when window moves
    Creator.Connect(RunService.RenderStepped, function()
        if opened then positionPopup() end
    end)

    refreshDisplay()
    return DropdownObj
end

