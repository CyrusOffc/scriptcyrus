-- ═══════════════ SPRING ANIMATION ENGINE ═══════════════
local Spring = {}
Spring.__index = Spring

function Spring.new(value, opts)
    opts = opts or {}
    return setmetatable({
        Value = value,
        Target = value,
        Velocity = 0,
        Freq = opts.frequency or 6,
        Damp = opts.damping or 1,
    }, Spring)
end

function Spring:Update(dt)
    local freq = self.Freq * 2 * math.pi
    local d = self.Damp
    local offset = self.Value - self.Target
    local decay = math.exp(-d * freq * dt)

    if d >= 1 then
        self.Value = (offset * (1 + freq * dt) + self.Velocity * dt) * decay + self.Target
        self.Velocity = (self.Velocity * (1 - freq * dt) - offset * (freq * freq * dt)) * decay
    else
        local c = math.sqrt(1 - d * d)
        local i = math.cos(freq * c * dt)
        local j = math.sin(freq * c * dt)
        local z = j / c
        local y = j / (freq * c)
        self.Value = (offset * (i + d * z) + self.Velocity * y) * decay + self.Target
        self.Velocity = (self.Velocity * (i - z * d) - offset * (z * freq)) * decay
    end

    if math.abs(self.Velocity) < 0.001 and math.abs(self.Value - self.Target) < 0.001 then
        self.Value = self.Target
        self.Velocity = 0
        return true
    end
    return false
end

function Spring:SetTarget(t)
    self.Target = t
end

-- ═══════════════ SIGNAL ═══════════════
local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({_c = {}, _t = {}}, Signal)
end

function Signal:Connect(fn)
    local c = {fn = fn, active = true}
    table.insert(self._c, c)
    return {
        Disconnect = function()
            c.active = false
            for i, x in pairs(self._c) do
                if x == c then table.remove(self._c, i) return end
            end
        end
    }
end

function Signal:Fire(...)
    for _, c in pairs(self._c) do
        if c.active then
            task.spawn(c.fn, ...)
        end
    end
end

-- ═══════════════ CREATOR ═══════════════
local Creator = { Connections = {} }

function Creator.Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Creator.Connections, c)
    return c
end

function Creator.Cleanup()
    for i = #Creator.Connections, 1, -1 do
        pcall(function() Creator.Connections[i]:Disconnect() end)
        Creator.Connections[i] = nil
    end
end

function Creator.New(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = obj
    end
    return obj
end

