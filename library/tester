function Element:AddSlider(cfg)
    cfg = cfg or {}
    local title = cfg.Title or "Slider"
    local min = cfg.Min or 0
    local max = cfg.Max or 100
    local default = cfg.Default or min
    local rounding = cfg.Rounding or 0

    local frame = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = CurrentTheme.BgElement,
        BorderSizePixel = 0,
        Parent = self.Container,
    })
    Creator.Corner(frame, 10)
    local stroke = Creator.Stroke(frame, CurrentTheme.Border, 1, 0.5)

    Creator.New("TextLabel", {
        Size = UDim2.new(1, -70, 0, 18),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = CurrentTheme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local valueLbl = Creator.New("TextLabel", {
        Size = UDim2.new(0, 60, 0, 18),
        Position = UDim2.new(1, -14, 0, 8),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = CurrentTheme.Accent,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local sliderBg = Creator.New("Frame", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 0, 40),
        BackgroundColor3 = CurrentTheme.BgHover,
        BorderSizePixel = 0,
        Parent = frame,
    })
    Creator.Corner(sliderBg, 3)

    local fill = Creator.New("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = CurrentTheme.Accent,
        BorderSizePixel = 0,
        Parent = sliderBg,
    })
    Creator.Corner(fill, 3)
    Creator.Gradient(fill, CurrentTheme.Accent2, CurrentTheme.Accent, 0)

    local knob = Creator.New("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = CurrentTheme.Text,
        BorderSizePixel = 0,
        Parent = sliderBg,
    })
    Creator.Corner(knob, 7)
    Creator.Stroke(knob, CurrentTheme.Accent, 2, 0)

    local SliderObj = {Value = default, Callback = cfg.Callback, Changed = nil}
    local dragging = false

    local function updateFromX(mouseX)
        local relX = math.clamp((mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local newVal = min + (max - min) * relX
        if rounding > 0 then
            newVal = math.floor(newVal * (10^rounding)) / (10^rounding)
        else
            newVal = math.floor(newVal)
        end
        SliderObj.SetValue(newVal)
    end

    SliderObj.SetValue = function(v)
        v = math.clamp(v, min, max)
        SliderObj.Value = v
        local rel = (v - min) / (max - min)
        Animator.Tween(fill, {Size = UDim2.new(rel, 0, 1, 0)}, 0.1)
        Animator.Tween(knob, {Position = UDim2.new(rel, -7, 0.5, -7)}, 0.1)
        valueLbl.Text = tostring(v)
        if SliderObj.Callback then task.spawn(function() pcall(SliderObj.Callback, v) end) end
        if SliderObj.Changed then task.spawn(function() pcall(SliderObj.Changed, v) end) end
    end

    SliderObj.GetValue = function() return SliderObj.Value end
    SliderObj.OnChanged = function(fn) SliderObj.Changed = fn fn(SliderObj.Value) end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return SliderObj
end

