                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(18, 28, 72)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(13, 21, 56)),
                    }),
                    Rotation = 90,
                }, KBFrame)
                
                local KBLabel = CreateInstance("TextLabel", {
                    Size = UDim2.new(1, -100, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = KBName,
                    TextSize = 12,
                    TextColor3 = Theme.TextPrimary,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 16,
                }, KBFrame)
                
                local KBBtn = CreateInstance("TextButton", {
                    Size = UDim2.new(0, 80, 0, 24),
                    Position = UDim2.new(1, -88, 0.5, -12),
                    BackgroundColor3 = Theme.InputBG,
                    BorderSizePixel = 0,
                    Text = KBDefault == Enum.KeyCode.Unknown and "NONE" or KBDefault.Name,
                    TextSize = 11,
                    TextColor3 = Theme.Gold,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 17,
                }, KBFrame)
                AddCorner(KBBtn, 4)
                AddStroke(KBBtn, Theme.GoldDark, 1)
                
                KBBtn.MouseButton1Click:Connect(function()
                    if not listening then
                        listening = true
                        KBBtn.Text = "..."
                        KBBtn.TextColor3 = Theme.GoldBright
                    end
                end)
                
                UserInputService.InputBegan:Connect(function(input, gpe)
                    if listening and not gpe then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            Keybind.Value = input.KeyCode
                            KBBtn.Text = input.KeyCode.Name
                            KBBtn.TextColor3 = Theme.Gold
                            listening = false
                        end
                    elseif not listening and input.KeyCode == Keybind.Value then
                        KBCallback(Keybind.Value)
                    end
                end)
                
                return Keybind
            end
            
            -- // LABEL
            function Section:AddLabel(config)
                config = config or {}
                local LText = config.Text or "Label"
                
                local LFrame = CreateInstance("Frame", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 15,
                }, SectionFrame)
                
                local LLabel = CreateInstance("TextLabel", {
                    Size = UDim2.new(1, -16, 1, 0),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundTransparency = 1,
                    Text = LText,
                    TextSize = 11,
                    TextColor3 = Theme.TextSecondary,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    RichText = true,
                    ZIndex = 16,
                }, LFrame)
                
                local Label = {}
                function Label:Set(text)
                    LLabel.Text = text
                end
                
                return Label
            end
            
            -- // SEPARATOR
            function Section:AddSeparator()
                local SepFrame = CreateInstance("Frame", {
                    Size = UDim2.new(1, 0, 0, 10),
                    BackgroundTransparency = 1,
                    ZIndex = 15,
                }, SectionFrame)
                
                local SepLine = CreateInstance("Frame", {
                    Size = UDim2.new(0.9, 0, 0, 1),
                    Position = UDim2.new(0.05, 0, 0.5, 0),
                    BackgroundColor3 = Theme.BorderDim,
                    BorderSizePixel = 0,
                    ZIndex = 16,
                }, SepFrame)
                
                local sepGrad = CreateInstance("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 80, 140)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
                    }),
                }, SepLine)
                
                return SepFrame
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- // KeyBind for Open/Close UI (default: RightShift)
    local ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == ToggleKey then
            if Window.Open then
                Window.Open = false
                Tween(MainFrame, {GroupTransparency = 1}, 0.3)
                task.delay(0.3, function()
                    MainFrame.Visible = false
                    FloatBtn.Visible = true
                end)
            else
                Window.Open = true
                FloatBtn.Visible = false
                MainFrame.Visible = true
                Tween(MainFrame, {GroupTransparency = 0}, 0.3)
            end
        end
    end)
    
    -- // Window API
    function Window:SetTitle(title)
        TitleLabel.Text = title
    end
    
    function Window:SetSubTitle(subtitle)
        SubTitleLabel.Text = subtitle
    end
    
    function Window:Toggle()
        if Window.Open then
            Window.Open = false
            Tween(MainFrame, {GroupTransparency = 1}, 0.3)
            task.delay(0.3, function()
                MainFrame.Visible = false
                FloatBtn.Visible = true
            end)
        else
            Window.Open = true
            FloatBtn.Visible = false
            MainFrame.Visible = true
            Tween(MainFrame, {GroupTransparency = 0}, 0.3)
        end
    end
    
    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    return Window
end

return Library
