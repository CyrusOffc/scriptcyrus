            tabScroll.CanvasSize = UDim2.new(0, 0, 0, tabScroll.UIListLayout.AbsoluteContentSize.Y + 8)
        end)

        local tabObj = setmetatable({
            Container = tabScroll,
            ScrollFrame = tabScroll,
            Button = tabBtn,
