    local KeybindObj = {Value = value, Mode = mode, Toggled = false}
    KeybindObj.Callback = cfg.Callback
    KeybindObj.Changed = nil
    local picking = false

    keyBtn.MouseButton1Click:Connect(function()
        picking = true
        keyBtn.Text = "..."
        Animator.Tween(stroke, {Color = CurrentTheme.Accent}, 0.2)
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
