        local newX = floatStartPos.X.Offset + delta.X
        local newY = floatStartPos.Y.Offset + delta.Y
        local vp = Camera.ViewportSize
        newX = math.clamp(newX, 0, vp.X - 56)
        newY = math.clamp(newY, 0, vp.Y - 56)
        FloatBtn.Position = UDim2.new(floatStartPos.X.Scale, newX, floatStartPos.Y.Scale, newY)
    end
end)

