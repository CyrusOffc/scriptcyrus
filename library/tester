            function Section:AddKeybind(config)
                config = config or {}
                local KBName = config.Name or "Keybind"
                local KBDefault = config.Default or Enum.KeyCode.Unknown
                local KBCallback = config.Callback or function() end
                
                local Keybind = {Value = KBDefault}
                local listening = false
                
                local KBFrame = CreateInstance("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
