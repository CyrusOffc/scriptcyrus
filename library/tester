-- ═══════════════ WINDOW CREATION ═══════════════
function CyrusUI:CreateWindow(config)
    config = config or {}
    local title = config.Title or "CyrusUI"
    local subtitle = config.SubTitle or "v" .. CyrusUI.Version
    local size = config.Size or UDim2.fromOffset(620, 460)
    local themeName = config.Theme or "CyrusPurple"

    if Themes[themeName] then
        CurrentTheme = Themes[themeName]
        CyrusUI.Theme = themeName
    end

    -- Update existing theme colors
    if floatStroke then floatStroke.Color = CurrentTheme.Accent end
    FloatBtn.BackgroundColor3 = CurrentTheme.BgSecondary
    FloatBtn.ImageColor3 = CurrentTheme.Accent

    -- Main window
    local Window = Creator.New("Frame", {
        Name = "CyrusWindow",
        Size = UDim2.new(0, size.X.Offset, 0, size.Y.Offset),
        Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2),
        BackgroundColor3 = CurrentTheme.BgMain,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Visible = false,
        Parent = MainGui,
    })
    Creator.Corner(Window, 16)
    local mainStroke = Creator.Stroke(Window, CurrentTheme.BorderAccent, 1.5, 0.3)
    Creator.Gradient(Window, CurrentTheme.BgSecondary, CurrentTheme.BgMain, 135)

    -- Header
    local header = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = Window,
    })

    local titleLbl = Creator.New("TextLabel", {
        Size = UDim2.new(1, -140, 0, 24),
        Position = UDim2.new(0, 20, 0, 12),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = CurrentTheme.Text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        Parent = header,
    })

    local subtitleLbl = Creator.New("TextLabel", {
        Size = UDim2.new(1, -140, 0, 16),
        Position = UDim2.new(0, 20, 0, 32),
        BackgroundTransparency = 1,
        Text = subtitle,
        TextColor3 = CurrentTheme.SubText,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        Parent = header,
    })

    -- Header line
    local headerLine = Creator.New("Frame", {
        Size = UDim2.new(1, -32, 0, 1),
        Position = UDim2.new(0, 16, 0, 51),
        BackgroundColor3 = CurrentTheme.Border,
        BorderSizePixel = 0,
        Parent = Window,
    })
    Creator.Gradient(headerLine, CurrentTheme.Accent, CurrentTheme.Accent2, 0)

    -- Window control buttons
    local function makeControlBtn(text, posX, callback, hoverColor)
        local btn = Creator.New("TextButton", {
            Size = UDim2.new(0, 28, 0, 28),
            Position = UDim2.new(1, posX, 0, 12),
            BackgroundColor3 = CurrentTheme.BgElement,
            BackgroundTransparency = 0.5,
            Text = text,
            TextColor3 = CurrentTheme.SubText,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false,
            Parent = header,
        })
        Creator.Corner(btn, 8)
        btn.MouseEnter:Connect(function()
            Animator.Tween(btn, {
                BackgroundColor3 = hoverColor or CurrentTheme.BgHover,
                BackgroundTransparency = 0,
                TextColor3 = CurrentTheme.Text,
            }, 0.2)
        end)
        btn.MouseLeave:Connect(function()
            Animator.Tween(btn, {
                BackgroundColor3 = CurrentTheme.BgElement,
                BackgroundTransparency = 0.5,
                TextColor3 = CurrentTheme.SubText,
            }, 0.2)
        end)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- Min button
    makeControlBtn("—", -100, function()
        Animator.Tween(Window, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
        }, 0.35, Enum.EasingStyle.Quint)
        task.delay(0.35, function()
            Window.Visible = false
        end)
    end)

    -- Max button
    local isMax = false
    local prevSize = size
    local maxBtn = makeControlBtn("☐", -68, function()
        isMax = not isMax
        if isMax then
            prevSize = UDim2.new(0, Window.AbsoluteSize.X, 0, Window.AbsoluteSize.Y)
            Animator.Tween(Window, {
                Size = UDim2.new(1, 0, 1, 0),
                Position = UDim2.new(0, 0, 0, 0),
            }, 0.35, Enum.EasingStyle.Quint)
            maxBtn.Text = "❐"
        else
            Animator.Tween(Window, {
                Size = prevSize,
                Position = UDim2.new(0.5, -prevSize.X.Offset/2, 0.5, -prevSize.Y.Offset/2),
            }, 0.35, Enum.EasingStyle.Quint)
            maxBtn.Text = "☐"
        end
    end)

    -- Close button
    makeControlBtn("✕", -36, function()
        Animator.Tween(Window, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 1,
        }, 0.3, Enum.EasingStyle.Quint)
        task.delay(0.3, function()
            Window.Visible = false
            Window.Size = UDim2.new(0, size.X.Offset, 0, size.Y.Offset)
            Window.Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2)
            Window.BackgroundTransparency = 0
        end)
        FloatBtn.Visible = true
    end, Color3.fromRGB(255, 70, 70))

    -- Sidebar
    local sidebar = Creator.New("Frame", {
        Size = UDim2.new(0, 150, 1, -80),
        Position = UDim2.new(0, 12, 0, 62),
        BackgroundColor3 = CurrentTheme.BgSecondary,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = Window,
    })
    Creator.Corner(sidebar, 12)

    local tabList = Creator.New("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = sidebar,
    })
    Creator.New("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tabList,
    })
    tabList.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabList.CanvasSize = UDim2.new(0, 0, 0, tabList.UIListLayout.AbsoluteContentSize.Y + 4)
    end)

    -- Content area
    local content = Creator.New("Frame", {
        Size = UDim2.new(1, -186, 1, -80),
        Position = UDim2.new(0, 174, 0, 62),
        BackgroundTransparency = 1,
        Parent = Window,
    })

    -- Tab display title
    local tabTitle = Creator.New("TextLabel", {
        Size = UDim2.new(1, -10, 0, 30),
        Position = UDim2.new(0, 4, 0, -2),
        BackgroundTransparency = 1,
        Text = "Tab",
        TextColor3 = CurrentTheme.Text,
        TextSize = 22,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        Parent = content,
    })

    -- Tab content holder
    local tabContentHolder = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 1, -36),
        Position = UDim2.new(0, 0, 0, 36),
        BackgroundTransparency = 1,
        Parent = content,
    })

    -- Window dragging
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Window.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Tabs system
    local tabs = {}
    local selectedTab = nil

    local WindowObj = {Tabs = tabs, Window = Window, FloatingButton = FloatBtn}

    function WindowObj:AddTab(cfg)
        cfg = cfg or {}
        local tabTitleText = cfg.Title or "Tab"

        local tabBtn = Creator.New("TextButton", {
            Size = UDim2.new(1, 0, 0, 38),
            BackgroundColor3 = CurrentTheme.BgElement,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            Parent = tabList,
        })
        Creator.Corner(tabBtn, 10)

        local indicator = Creator.New("Frame", {
            Size = UDim2.new(0, 3, 0, 20),
            Position = UDim2.new(0, 0, 0.5, -10),
            BackgroundColor3 = CurrentTheme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = tabBtn,
        })
        Creator.Corner(indicator, 2)

        local tabLabel = Creator.New("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = tabTitleText,
            TextColor3 = CurrentTheme.SubText,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            RichText = true,
            Parent = tabBtn,
        })

        local tabScroll = Creator.New("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = CurrentTheme.Accent,
            ScrollBarImageTransparency = 0.5,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false,
            Parent = tabContentHolder,
        })
        Creator.New("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = tabScroll,
        })
        Creator.Padding(tabScroll, 2, 4, 4, 2)
        tabScroll.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabScroll.CanvasSize = UDim2.new(0, 0, 0, tabScroll.UIListLayout.AbsoluteContentSize.Y + 8)
        end)

        local tabObj = setmetatable({
            Container = tabScroll,
            ScrollFrame = tabScroll,
            Button = tabBtn,
            Content = tabScroll,
            Name = tabTitleText,
        }, Element)

        tabBtn.MouseEnter:Connect(function()
            if selectedTab ~= tabObj then
                Animator.Tween(tabBtn, {BackgroundTransparency = 0.6, BackgroundColor3 = CurrentTheme.BgHover}, 0.2)
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if selectedTab ~= tabObj then
                Animator.Tween(tabBtn, {BackgroundTransparency = 1}, 0.2)
            end
        end)

        function tabObj:Select()
            for _, t in pairs(tabs) do
                t.Content.Visible = false
                Animator.Tween(t.Button, {BackgroundTransparency = 1}, 0.2)
                Animator.Tween(t.Button:FindFirstChildOfClass("Frame"), {BackgroundTransparency = 1}, 0.2)
                t.Button.TextLabel.TextColor3 = CurrentTheme.SubText
            end
            tabScroll.Visible = true
            Animator.Tween(tabBtn, {BackgroundTransparency = 0.4, BackgroundColor3 = CurrentTheme.Accent}, 0.25)
            Animator.Tween(indicator, {BackgroundTransparency = 0}, 0.25)
            tabLabel.TextColor3 = CurrentTheme.Text
            tabTitle.Text = tabTitleText
            selectedTab = tabObj
        end

        tabBtn.MouseButton1Click:Connect(function()
            tabObj:Select()
        end)

        table.insert(tabs, tabObj)

        if #tabs == 1 then
            task.defer(function() tabObj:Select() end)
        end

        return tabObj
    end

    -- Minimize keybind
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == CyrusUI.MinimizeKey then
            if Window.Visible then
                Animator.Tween(Window, {
                    Size = UDim2.new(0, 0, 0, 0),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                }, 0.3, Enum.EasingStyle.Quint)
                task.delay(0.3, function() Window.Visible = false end)
                FloatBtn.Visible = true
            else
                FloatBtn.Visible = true
            end
        end
    end)

    -- Float button toggle
    FloatBtn.MouseButton1Click:Connect(function()
        if Window.Visible then
            -- Hide
            Animator.Tween(Window, {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
            }, 0.35, Enum.EasingStyle.Quint)
            task.delay(0.35, function() Window.Visible = false end)
        else
            -- Show
            Window.Visible = true
            Window.Size = UDim2.new(0, 0, 0, 0)
            Window.Position = UDim2.new(0.5, 0, 0.5, 0)
            Animator.Tween(Window, {
                Size = UDim2.new(0, size.X.Offset, 0, size.Y.Offset),
                Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2),
            }, 0.35, Enum.EasingStyle.Quint)
        end
    end)

    -- Show window initially
    Window.Visible = true
    Window.Size = UDim2.new(0, 0, 0, 0)
    Window.Position = UDim2.new(0.5, 0, 0.5, 0)
    Animator.Tween(Window, {
        Size = UDim2.new(0, size.X.Offset, 0, size.Y.Offset),
        Position = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2),
    }, 0.5, Enum.EasingStyle.Quint)

    CyrusUI.Window = WindowObj

    -- Welcome notification
    task.delay(0.8, function()
        Notify({
            Title = '<font color="#b446ff">✦ CyrusUI</font> <font color="#ffffff">v3.0</font>',
            Content = "Interface loaded successfully!",
            SubContent = "Discord: discord.gg/speedhubx",
            Duration = 8,
        })
    end)

    return WindowObj
end

function CyrusUI:SetTheme(name)
    if Themes[name] then
        CurrentTheme = Themes[name]
        CyrusUI.Theme = name
        Notify({
            Title = "Theme",
            Content = "Changed to " .. name,
            Duration = 3,
        })
    end
end

function CyrusUI:Notify(cfg)
    return Notify(cfg)
end

function CyrusUI:Destroy()
    Creator.Cleanup()
    for _, conn in ipairs(ActiveSprings) do
        pcall(function() conn:Disconnect() end)
    end
    MainGui:Destroy()
end

-- Global export
_G.CyrusUI = CyrusUI
if getgenv then getgenv().CyrusUI = CyrusUI end

return CyrusUI
