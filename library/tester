function CyrusUI:SetTheme(name)
    if Themes[name] then
        CurrentTheme = Themes[name]
        CyrusUI.Theme = name
        Notify({Title = "Theme", Content = "Changed to " .. name, Duration = 3})
    end
end

function CyrusUI:Notify(cfg) return Notify(cfg) end

function CyrusUI:Destroy()
    Creator.Cleanup()
    MainGui:Destroy()
end

