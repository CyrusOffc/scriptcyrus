function Element:AddColorpicker(cfg)
    cfg = cfg or {}
    local title = cfg.Title or "Color"
    local value = cfg.Default or Color3.fromRGB(155, 70, 255)

    local frame = Creator.New("Frame", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = CurrentTheme.BgElement,
        BorderSizePixel = 0,
        Parent = self.Container,
    })
    Creator.Corner(frame, 10)
    Creator.Stroke(frame, CurrentTheme.Border, 1, 0.5)

    Creator.New("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = CurrentTheme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local colorBtn = Creator.New("TextButton", {
        Size = UDim2.new(0, 40, 0, 26),
        Position = UDim2.new(1, -14, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = value,
        Text = "",
        AutoButtonColor = false,
        Parent = frame,
    })
    Creator.Corner(colorBtn, 8)
    Creator.Stroke(colorBtn, Color3.fromRGB(255,255,255), 1.5, 0.6)

    local CPObj = {Value = value}
    CPObj.Callback = cfg.Callback
    CPObj.Changed = nil

    colorBtn.MouseButton1Click:Connect(function()
        -- Cycle hue on click (simple)
        local h, s, v = Color3.toHSV(CPObj.Value)
        h = (h + 0.1) % 1
        CPObj.Value = Color3.fromHSV(h, s, v)
        colorBtn.BackgroundColor3 = CPObj.Value
        if CPObj.Callback then task.spawn(function() pcall(CPObj.Callback, CPObj.Value) end) end
        if CPObj.Changed then task.spawn(function() pcall(CPObj.Changed, CPObj.Value) end) end
    end)

    CPObj.SetValue = function(c)
        CPObj.Value = c
        colorBtn.BackgroundColor3 = c
    end
    CPObj.SetValueRGB = function(c) CPObj.SetValue(c) end
    CPObj.GetValue = function() return CPObj.Value end
    CPObj.OnChanged = function(fn) CPObj.Changed = fn fn(CPObj.Value) end

    return CPObj
end

