            }),
        })

        local HolderCanvas = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(170, 300),
            Parent = Library.GUI,
            Visible = false,
        }, {
            HolderFrame,
            New("UISizeConstraint", { MinSize = Vector2.new(170, 0) }),
        })
        table.insert(Library.OpenFrames, HolderCanvas)

        local function recalcPosition()
            local add = 0
            if Camera.ViewportSize.Y - Inner.AbsolutePosition.Y < HolderCanvas.AbsoluteSize.Y - 5 then
                add = HolderCanvas.AbsoluteSize.Y - 5 - (Camera.ViewportSize.Y - Inner.AbsolutePosition.Y) + 40
            end
            HolderCanvas.Position = UDim2.fromOffset(Inner.AbsolutePosition.X - 1, Inner.AbsolutePosition.Y - 5 - add)
        end

        local ListSizeX = 0
        local function recalcSize()
            if #Dropdown.Values > 10 then
                HolderCanvas.Size = UDim2.fromOffset(ListSizeX, 392)
            else
                HolderCanvas.Size = UDim2.fromOffset(ListSizeX, ListLayout.AbsoluteContentSize.Y + 10)
            end
        end

        local function recalcCanvas()
            ScrollFrame.CanvasSize = UDim2.fromOffset(0, ListLayout.AbsoluteContentSize.Y)
        end

        recalcPosition()
        recalcSize()

        Creator.AddSignal(Inner:GetPropertyChangedSignal("AbsolutePosition"), recalcPosition)
        Creator.AddSignal(Inner.MouseButton1Click, function() Dropdown:Open() end)

        Creator.AddSignal(UserInputService.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local abs, size = HolderFrame.AbsolutePosition, HolderFrame.AbsoluteSize
                if Mouse.X < abs.X or Mouse.X > abs.X + size.X or Mouse.Y < (abs.Y - 21) or Mouse.Y > abs.Y + size.Y then
                    Dropdown:Close()
                end
            end
        end)

        local parentScroll = self.ScrollFrame

        function Dropdown:Open()
            Dropdown.Opened = true
            parentScroll.ScrollingEnabled = false
            HolderCanvas.Visible = true
            TweenService:Create(HolderFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.fromScale(1, 1),
            }):Play()
        end

        function Dropdown:Close()
            Dropdown.Opened = false
            parentScroll.ScrollingEnabled = true
            HolderFrame.Size = UDim2.fromScale(1, 0.6)
            HolderCanvas.Visible = false
        end

        function Dropdown:Display()
            local str = ""
            if config.Multi then
                for _, v in next, Dropdown.Values do
                    if Dropdown.Value[v] then str = str .. v .. ", " end
                end
                str = str:sub(1, #str - 2)
            else
                str = Dropdown.Value or ""
            end
            Display.Text = (str == "" and "--" or str)
        end

        function Dropdown:GetActiveValues()
            if config.Multi then
                local t = {}
                for v, b in next, Dropdown.Value do table.insert(t, v) end
                return t
            end
            return Dropdown.Value and 1 or 0
        end

        function Dropdown:BuildDropdownList()
            local buttons = {}

            for _, e in next, ScrollFrame:GetChildren() do
                if not e:IsA("UIListLayout") then e:Destroy() end
            end

            for _, value in next, Dropdown.Values do
                local t = {}

                local ButtonSelector = New("Frame", {
                    Size = UDim2.fromOffset(4, 14),
                    BackgroundColor3 = Color3.fromRGB(76, 194, 255),
                    Position = UDim2.fromOffset(-1, 16),
                    AnchorPoint = Vector2.new(0, 0.5),
                    ThemeTag = { BackgroundColor3 = "Accent" },
                }, { New("UICorner", { CornerRadius = UDim.new(0, 2) }) })

                local ButtonLabel = New("TextLabel", {
                    FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json"),
                    Text = value,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Position = UDim2.fromOffset(10, 0),
                    Name = "ButtonLabel",
                    ThemeTag = { TextColor3 = "Text" },
                })

                local Button = New("TextButton", {
                    Size = UDim2.new(1, -5, 0, 32),
                    BackgroundTransparency = 1,
                    ZIndex = 23,
                    Text = "",
                    Parent = ScrollFrame,
                    ThemeTag = { BackgroundColor3 = "DropdownOption" },
                }, {
                    ButtonSelector,
                    ButtonLabel,
                    New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                })

                local selected
                if config.Multi then selected = Dropdown.Value[value]
                else selected = Dropdown.Value == value end

                local motor, setTransparency = Creator.SpringMotor(1, Button, "BackgroundTransparency")
                local selMotor, setSelTransparency = Creator.SpringMotor(1, ButtonSelector, "BackgroundTransparency")
                local sizeMotor = Motor.new(6)
                sizeMotor:onStep(function(v) ButtonSelector.Size = UDim2.new(0, 4, 0, v) end)

                Creator.AddSignal(Button.MouseEnter, function()
                    setTransparency(selected and 0.85 or 0.89)
                end)
                Creator.AddSignal(Button.MouseLeave, function()
                    setTransparency(selected and 0.89 or 1)
                end)
                Creator.AddSignal(Button.MouseButton1Down, function() setTransparency(0.92) end)
                Creator.AddSignal(Button.MouseButton1Up, function()
                    setTransparency(selected and 0.85 or 0.89)
                end)

                function t:UpdateButton()
                    if config.Multi then
                        selected = Dropdown.Value[value]
                        if selected then setTransparency(0.89) end
                    else
                        selected = Dropdown.Value == value
                        setTransparency(selected and 0.89 or 1)
                    end
                    sizeMotor:setGoal(Flipper.Spring(selected and 14 or 6, { frequency = 6 }))
                    setSelTransparency(selected and 0 or 1)
                end

                ButtonLabel.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        local try = not selected
                        if Dropdown:GetActiveValues() == 1 and not try and not config.AllowNull then return end

                        if config.Multi then
                            selected = try
                            Dropdown.Value[value] = selected and true or nil
                        else
                            selected = try
                            Dropdown.Value = selected and value or nil
                            for _, other in next, buttons do other:UpdateButton() end
                        end

                        t:UpdateButton()
                        Dropdown:Display()
                        Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
                        Library:SafeCallback(Dropdown.Changed, Dropdown.Value)
                    end
                end)

                t:UpdateButton()
                Dropdown:Display()
                buttons[Button] = t
            end

            ListSizeX = 0
            for button, _ in next, buttons do
                local lbl = button:FindFirstChild("ButtonLabel")
                if lbl and lbl.TextBounds.X > ListSizeX then ListSizeX = lbl.TextBounds.X end
            end
            ListSizeX = ListSizeX + 30

            recalcCanvas()
            recalcSize()
        end

        function Dropdown:SetValues(new)
            if new then Dropdown.Values = new end
            Dropdown:BuildDropdownList()
        end

        function Dropdown:OnChanged(fn) Dropdown.Changed = fn fn(Dropdown.Value) end

        function Dropdown:SetValue(val)
            if Dropdown.Multi then
                local t = {}
                for v, b in next, val do
                    if table.find(Dropdown.Values, v) then t[v] = true end
                end
                Dropdown.Value = t
            else
                if not val then Dropdown.Value = nil
                elseif table.find(Dropdown.Values, val) then Dropdown.Value = val end
            end
            Dropdown:BuildDropdownList()
            Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
            Library:SafeCallback(Dropdown.Changed, Dropdown.Value)
        end

        function Dropdown:Destroy()
            Frame:Destroy()
            Library.Options[idx] = nil
        end

        Dropdown:BuildDropdownList()
        Dropdown:Display()
        Library.Options[idx] = Dropdown
        return Dropdown
    end

    return Element
end)()

