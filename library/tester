                    Size = UDim2.new(1, -16, 1, 0),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundTransparency = 1,
                    Text = InputDefault,
                    PlaceholderText = InputPlaceholder,
                    PlaceholderColor3 = Theme.TextDim,
                    TextSize = 11,
                    TextColor3 = Theme.TextPrimary,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = InputClearOnFocus,
                    RichText = false,
                    ZIndex = 17,
                }, InputBG)
                
                TextBox.Focused:Connect(function()
                    Tween(InputBG, {BackgroundColor3 = Color3.fromRGB(10, 18, 50)}, 0.2)
                    -- Animate stroke to gold
                    for _, v in pairs(InputBG:GetDescendants()) do
                        if v:IsA("UIStroke") then
                            Tween(v, {Color = Theme.Gold}, 0.2)
                        end
                    end
                end)
                
                TextBox.FocusLost:Connect(function(enterPressed)
                    Tween(InputBG, {BackgroundColor3 = Theme.InputBG}, 0.2)
                    for _, v in pairs(InputBG:GetDescendants()) do
                        if v:IsA("UIStroke") then
                            Tween(v, {Color = Theme.BorderDim}, 0.2)
                        end
                    end
                    Input.Value = TextBox.Text
                    if enterPressed then
                        InputCallback(TextBox.Text)
                    end
                end)
                
                TextBox:GetPropertyChangedSignal("Text"):Connect(function()
                    Input.Value = TextBox.Text
                    InputCallback(TextBox.Text)
                end)
                
                function Input:Set(val)
                    TextBox.Text = val
                    Input.Value = val
                end
                
                return Input
            end
            
