function Creator.AddSignal(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Creator.Signals, c)
    return c
end

function Creator.Disconnect()
    for i = #Creator.Signals, 1, -1 do
        local c = table.remove(Creator.Signals, i)
        if c.Disconnect then pcall(function() c:Disconnect() end) end
    end
end

function Creator.AddThemeObject(object, properties)
    Creator.Registry[object] = { Properties = properties }
    Creator.UpdateTheme()
    return object
end

function Creator.GetThemeProperty(prop)
    return Themes[Library.Theme][prop] or Themes["CyrusPurple"][prop]
end

function Creator.UpdateTheme()
    for obj, data in next, Creator.Registry do
        for prop, key in next, data.Properties do
            pcall(function() obj[prop] = Creator.GetThemeProperty(key) end)
        end
    end
    for _, motor in next, Creator.TransparencyMotors do
        motor:setGoal(Flipper.Instant(Creator.GetThemeProperty("ElementTransparency")))
    end
end

function Creator.OverrideTag(object, properties)
    if Creator.Registry[object] then
        Creator.Registry[object].Properties = properties
    end
end

function Creator.New(name, properties, children)
    local obj = Instance.new(name)
    for k, v in next, Creator.DefaultProperties[name] or {} do obj[k] = v end
    for k, v in next, properties or {} do
        if k ~= "ThemeTag" then obj[k] = v end
    end
    for _, child in next, children or {} do child.Parent = obj end
    if properties and properties.ThemeTag then
        Creator.AddThemeObject(obj, properties.ThemeTag)
    end
    return obj
end

function Creator.SpringMotor(initial, instance, prop, ignoreDialogCheck, resetOnThemeChange)
    local motor = Motor.new(initial)
    motor:onStep(function(v) instance[prop] = v end)
    if resetOnThemeChange then table.insert(Creator.TransparencyMotors, motor) end
    local function setValue(v, ignore)
        if not ignoreDialogCheck and not ignore and prop == "BackgroundTransparency" and Library.DialogOpen then
            return
        end
        motor:setGoal(Flipper.Spring(v, { frequency = 8 }))
    end
    return motor, setValue
end

